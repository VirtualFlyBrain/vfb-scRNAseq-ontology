            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Posterior-most synaptic neuropil domain of the midline. It is the only synaptic neuropil domain outside of the central complex that is fused across the midline. It is located behind the fan-shaped body and below the protocerebral bridge.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-13T04:53:41Z</dc:date>
