    <owl:Ontology rdf:about="http://virtualflybrain.org/data/VFB/OWL/VFB_scRNAseq_FBlc0006887.owl">
        <dc:description>An ontology of Drosophila melanogaster scRNAseq data from a single dataset (FBlc0006887). This information is taken from FlyBase, which sources it from the EMBL-EBI Single Cell Expression Atlas, which compiles scRNAseq data from multiple sources.</dc:description>
        <dc:title>VFB scRNAseq Ontology for dataset FBlc0006887</dc:title>
    </owl:Ontology>
    


