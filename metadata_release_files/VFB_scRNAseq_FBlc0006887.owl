    <!-- http://purl.obolibrary.org/obo/FBdv_00005311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBdv_00005311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005259"/>
