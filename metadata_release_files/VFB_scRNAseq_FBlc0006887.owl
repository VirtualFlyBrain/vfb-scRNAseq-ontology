    <!-- http://purl.obolibrary.org/obo/FBbt_00005074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100318"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005106"/>
        <obo:IAO_0000115>Somatic, contractile cell that makes up a muscle. It is formed by several fusion events between fusion competent myoblasts and one founder cell.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000187</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>muscle fiber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>myofiber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>myofibril</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00005074</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#scrnaseq_slim"/>
        <rdfs:comment>In contrast to vertebrates, in Drosophila embryos and larva, each muscle is a single myotube (Maqbool and Jagla, 2007).</rdfs:comment>
        <rdfs:label>muscle cell</rdfs:label>
    </owl:Class>
