        <oboInOwl:hasBroadSynonym>post-feeding larva</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005341</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 460.</rdfs:comment>
        <rdfs:label>wandering third instar larval stage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
