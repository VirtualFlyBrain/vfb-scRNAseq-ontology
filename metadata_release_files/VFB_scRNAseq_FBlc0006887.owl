            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ascending neuron of the larva, having its soma in the ventral nerve cord and processes extending into the brain (Winding et al. (2023).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-08-17T13:27:11Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051303</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>larval AN</oboInOwl:hasExactSynonym>
