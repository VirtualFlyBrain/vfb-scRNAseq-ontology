                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005262"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oogenesis stage that begins when the oocyte chromosomes condense into a karyosome attached to a distinctive spherical structure known as an endobody. The oocyte nucleolus disappears completely. During this stage, nurse cell ploidy reaches 16C.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005263</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 10030.</rdfs:comment>
        <rdfs:label>oogenesis stage S3</rdfs:label>
    </owl:Class>
