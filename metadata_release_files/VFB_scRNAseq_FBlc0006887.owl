        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>embryonic/larval salivary gland common duct</rdfs:label>
    </owl:Class>
    <owl:Axiom>
