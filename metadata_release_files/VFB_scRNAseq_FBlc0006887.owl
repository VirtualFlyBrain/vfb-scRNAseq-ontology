        <obo:IAO_0000112>&apos;mitochondrial transport&apos; results_in_transport_to_from_or_in some  mitochondrion (GO:0005739)</obo:IAO_0000112>
        <obo:IAO_0000117 rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <rdfs:label xml:lang="en">results in transport to from or in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002350 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002350">
