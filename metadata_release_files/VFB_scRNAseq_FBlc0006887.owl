    <!-- http://purl.obolibrary.org/obo/FBbt_00003625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00049603"/>
        <rdfs:subClassOf>
            <owl:Restriction>
