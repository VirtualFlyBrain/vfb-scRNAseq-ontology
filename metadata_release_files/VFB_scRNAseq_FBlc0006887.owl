    <!-- http://purl.obolibrary.org/obo/FBbt_00006007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00006007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00006009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0013002"/>
