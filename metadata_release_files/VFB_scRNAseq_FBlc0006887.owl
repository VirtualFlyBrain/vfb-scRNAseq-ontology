        <rdfs:label xml:lang="en">during which starts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0002090 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002090">
