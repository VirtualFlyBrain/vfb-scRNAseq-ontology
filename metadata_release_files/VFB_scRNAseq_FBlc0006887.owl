            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ridge of the operculum becomes distinct. Puparium begins to separate from underlying epidermis. Becomes positively buoyant. Duration at 25 degrees C: approximately 4 hours, 45 minutes. (122-126.75 hours after egg laying; 2-6.75 hours after puparium formation).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>bubble prepupa stage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pupal stage P3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005345</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 530.</rdfs:comment>
        <rdfs:label>prepupal stage P3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005345"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ridge of the operculum becomes distinct. Puparium begins to separate from underlying epidermis. Becomes positively buoyant. Duration at 25 degrees C: approximately 4 hours, 45 minutes. (122-126.75 hours after egg laying; 2-6.75 hours after puparium formation).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0036849</oboInOwl:hasDbXref>
