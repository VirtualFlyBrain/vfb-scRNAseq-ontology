    <!-- http://purl.obolibrary.org/obo/FBbt_00111204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00111204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052192"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Larval synaptic neuropil domain located posterior to the medial lobe of the mushroom body and the larval crepine (Hartenstein et al., 2015). It is the larval counterpart of the adult superior clamp (medial and lateral inferior protocerebrum) (Pereanu et al., 2010).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-09-15T14:47:42Z</dc:date>
