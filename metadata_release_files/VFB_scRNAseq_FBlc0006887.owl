            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Immature secondary neuron that is a precursor to an adult T4 neuron (Hormann et al., 2020). It is generated from a neuroblast that amplifies by symmetric division (type III) before generating the T4 (and T5) neurons (Mora et al., 2018). During its development, it first projects its axon to the appropriate lobula plate layer, then forms its dendrites in medulla layer 10 (Hormann et al., 2020).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-08-05T09:49:06Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00052257</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>developing T4 neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00052257</oboInOwl:id>
        <rdfs:label>immature T4 neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
