                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005280"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oogenesis stage during which only 7-8 nurse cell nuclei remain at the anterior of the oocyte. At the beginning of this stage, oocyte chromosome bivalents separate from each other - indicating mid-prometaphase of oocyte meiosis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005281</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 10230.</rdfs:comment>
        <rdfs:label>oogenesis stage S13C</rdfs:label>
