    <!-- http://purl.obolibrary.org/obo/FBbt_00004876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004866"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004873"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Female germline cell which is the daughter of a female germline stem cell. It is found in region 1 of the germarium. It divides four times to give rise to 16 daughter cyst cells, which together form a germline cyst. Division is through a cleavage-like process, with the daughter cells being smaller than the parent cystoblast.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004876</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#RD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>cystoblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004876"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Female germline cell which is the daughter of a female germline stem cell. It is found in region 1 of the germarium. It divides four times to give rise to 16 daughter cyst cells, which together form a germline cyst. Division is through a cleavage-like process, with the daughter cells being smaller than the parent cystoblast.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064777</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00004877 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00057012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007137"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004876"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Female germline cell born during one of four rapid rounds of cell division following the birth of a cystoblast from a female germline stem cell until the point where one of the resulting 16 cells (the presumptive oocyte) enters meiosis. Cyst cells are interconnected by ring canals, resulting from incomplete cytokinesis during cell division. The oocyte develops from one of the two cyst cells that have connections to four other cyst cells, the other 15 cyst cells differentiate into nurse cells.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/696</obo:IAO_0000233>
        <oboInOwl:hasBroadSynonym>cyst cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>cystocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>germarial cystocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004877</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#RD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>cyst cell of ovary</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004877"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Female germline cell born during one of four rapid rounds of cell division following the birth of a cystoblast from a female germline stem cell until the point where one of the resulting 16 cells (the presumptive oocyte) enters meiosis. Cyst cells are interconnected by ring canals, resulting from incomplete cytokinesis during cell division. The oocyte develops from one of the two cyst cells that have connections to four other cyst cells, the other 15 cyst cells differentiate into nurse cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0021038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064777</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cystocyte</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0064777</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004877"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>germarial cystocyte</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0021038</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00004886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004886">
