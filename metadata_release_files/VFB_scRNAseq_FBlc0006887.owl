        <obo:IAO_0000115>Cluster of cells in the ventrolateral ectoderm in the embryonic thorax that will eventually give rise to a dorsal imaginal disc, a ventral (leg) imaginal disc and a Keilin organ in the larva. The three different cellular identities cannot be distinguished at stage 11, but can by stage 14. There is one per thoracic hemisegment (six total).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/510</obo:IAO_0000233>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2019-08-23T09:38:06Z</dc:date>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00048408</oboInOwl:id>
        <rdfs:label>thoracic limb primordium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cluster of cells in the ventrolateral ectoderm in the embryonic thorax that will eventually give rise to a dorsal imaginal disc, a ventral (leg) imaginal disc and a Keilin organ in the larva. The three different cellular identities cannot be distinguished at stage 11, but can by stage 14. There is one per thoracic hemisegment (six total).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0183907</oboInOwl:hasDbXref>
    </owl:Axiom>
    


