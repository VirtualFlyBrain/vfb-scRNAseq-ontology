        <oboInOwl:hasExactSynonym>antenno-mechanosensory center</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dorsal lobe</oboInOwl:hasRelatedSynonym>
