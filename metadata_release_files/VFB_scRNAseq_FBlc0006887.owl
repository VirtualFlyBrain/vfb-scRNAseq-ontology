            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FBdv_00018001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00004886"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
