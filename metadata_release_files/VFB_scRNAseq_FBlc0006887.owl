                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100509"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cell body glial cell of the lamina. Unlike in other cell body rind regions of the brain, the cell body glia of the lamina form two distinct layers and multiple neuronal cell bodies may be found in one glial pocket (Kremer et al., 2017).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00100508</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>VFB:FBbt_00005723</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina cortex glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00005723</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>adult lamina satellite glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005723"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cell body glial cell of the lamina. Unlike in other cell body rind regions of the brain, the cell body glia of the lamina form two distinct layers and multiple neuronal cell bodies may be found in one glial pocket (Kremer et al., 2017).</owl:annotatedTarget>
