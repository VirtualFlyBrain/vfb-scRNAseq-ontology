    <!-- http://purl.obolibrary.org/obo/FBbt_00002037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00002037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005105"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Larval nerve found in segments T1-A7 that has two roots, both carrying fibers from the neuromere of the nerve (Campos-Ortega and Hartenstein, 1997). It exits the lateral ventral nerve cord in line with the anterior commissure and its proximal region shares a glial sheath with the intersegmental nerve (Campos-Ortega and Hartenstein, 1997). It does not extend as far dorsally as the intersegmental nerve, and mainly innervates ventral muscles and sense organs (Campos-Ortega and Hartenstein, 1997).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00002037</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>larval SN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>posterior fascicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00002037</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>larval segmental nerve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00002037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Larval nerve found in segments T1-A7 that has two roots, both carrying fibers from the neuromere of the nerve (Campos-Ortega and Hartenstein, 1997). It exits the lateral ventral nerve cord in line with the anterior commissure and its proximal region shares a glial sheath with the intersegmental nerve (Campos-Ortega and Hartenstein, 1997). It does not extend as far dorsally as the intersegmental nerve, and mainly innervates ventral muscles and sense organs (Campos-Ortega and Hartenstein, 1997).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0089570</oboInOwl:hasDbXref>
    </owl:Axiom>
    


