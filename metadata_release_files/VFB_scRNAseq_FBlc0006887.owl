    <!-- http://purl.obolibrary.org/obo/FBbt_00001303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001303">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FBbt_00005144"/>
