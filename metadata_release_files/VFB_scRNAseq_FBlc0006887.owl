    <!-- http://purl.obolibrary.org/obo/FBbt_00045037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00045037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040037"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thin, bilaterally paired synaptic neuropil domain that wraps around the medial lobe of the mushroom body. Many neurons in this domain enter the lobes to form extensive connections with Kenyon cell fibers.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00045037</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CRE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IPa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>IDFP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>aimpr</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>anterior inferior medial protocerebrum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>anterior inferior protocerebrum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00045037</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#BrainName"/>
        <rdfs:comment>The name crepine is used in French cuisine to refer to a slice of meat wrapped around some delicacy. The posterior region of the crepine corresponds to the dorsal part of the inferior dorsofrontal protocerebrum (IDFP) of Chiang et al. (2011) (Ito et al., 2014).</rdfs:comment>
        <rdfs:label>adult crepine</rdfs:label>
        <foaf:depiction>https://cdn.ncbi.nlm.nih.gov/pmc/blobs/f073/4407839/e48065582b72/cne0523-0997-f1.jpg</foaf:depiction>
    </owl:Class>
