    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00058882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058881"/>
        <obo:IAO_0000115>Muscle involved in flight that is not directly attached to the wing base. It derives from an indirect flight muscle precursor cell of the wing disc (Sudarsan et al., 2001).</obo:IAO_0000115>
