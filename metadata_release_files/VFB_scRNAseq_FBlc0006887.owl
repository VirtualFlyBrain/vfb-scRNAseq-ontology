        <rdfs:label>ejaculatory duct</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Unpaired duct that connects the male accessory glands and vasa deferentia to the aedeagus in the adult male genitalia. It is divided in an anterior ejaculatory duct and a posterior ejaculatory duct, separated by the ejaculatory bulb (Miller, 1941).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0005539</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0075527</oboInOwl:hasDbXref>
