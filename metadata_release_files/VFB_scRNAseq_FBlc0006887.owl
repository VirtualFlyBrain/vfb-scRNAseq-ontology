            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cytoplasmic bud that forms at the posterior pole of the embryo during cycle 9. Pole buds give rise to the pole cells.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
