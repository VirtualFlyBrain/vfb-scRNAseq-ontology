                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005348"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Legs and wings reach full extension along abdomen. Enlarged initial segments of anterior pair Malpighian tubules move from thorax into abdomen. Translucent patch that lacks adhering fat body cells becomes discernible in the middle of the eye region. Pair of white Malpighian tubules becomes visible dorsally in the abdomen. Duration at 25 degrees C: approximately 66 minutes. (132.2-133.3 hours after egg laying; 12.2-13.3 hours after puparium formation).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Malpighian tubules migrating</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005351</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 590.</rdfs:comment>
        <rdfs:label>pupal stage P5(i)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
