        <oboInOwl:hasExactSynonym>stalk of corpora pedunculata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stalk of mushroom body</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003687</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#BrainName"/>
