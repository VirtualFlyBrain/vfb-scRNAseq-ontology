                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001102"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Neuropil glial cell of the larval ventral nerve cord. These cells have their somas in the neuropil glial sheath and extend processes around or into the neuropil (Pogodalla et al., 2021). The encasement of the neuropil by the sheath is not complete in the first instar, but becomes complete by the third instar (Pogodalla et al., 2021).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-22T09:55:33Z</dc:date>
