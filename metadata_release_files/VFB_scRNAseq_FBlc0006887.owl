                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0013469"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Non-proliferative cell that arises from the division of an intestinal stem cell in the adult midgut and is committed to differentiate into an enterocyte (Zeng and Hou, 2015; He et al., 2018; Reiff et al., 2019).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-01-10T05:10:14Z</dc:date>
        <oboInOwl:hasExactSynonym>EB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Notch-active enterocyte progenitor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enterocyte-committed progenitor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00110205</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>These cells can be identified by their expression of a Su(H)GBE reporter, indicating active Notch signaling (He et al., 2018; Reiff et al., 2019). Cells expressing this reporter do not differentiate into enteroendocrine cells under normal conditions (Zeng and Hou, 2015). They also express klumpfuss (Reiff et al., 2019).</rdfs:comment>
        <rdfs:label>enteroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
