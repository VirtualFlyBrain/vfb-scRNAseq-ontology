        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00047856"/>
        <obo:IAO_0000115>Ensheathing glial cell of the larva. There are approximately 112 of these cells in the third instar central nervous system (Pogodalla et al., 2021). Some of these cells are polyploid, but others can undergo cell division during the pupal stage to generate adult glia (Kato et al., 2020).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-17T09:44:55Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00047837</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>L-EG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval ensheathing neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval pEG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval primary ensheathing glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00047837</oboInOwl:id>
        <rdfs:label>embryonic/larval ensheathing glial cell</rdfs:label>
