    <!-- http://purl.obolibrary.org/obo/FBbt_00007402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00007402">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
