    <!-- http://purl.obolibrary.org/obo/FBbt_00100015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051393"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
