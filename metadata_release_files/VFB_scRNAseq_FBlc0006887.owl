                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00047511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028>AHN</obo:IAO_0000028>
        <obo:IAO_0000115>Adult histaminergic neuron with its soma in the ventral nerve cord and an ascending projection through contralateral side of the cervical connective (Cheong et al., 2024). There are two pairs of these per organism, with somas in the metathoracic and mesothoracic neuromeres (Cheong et al., 2024). They receive the majority of their input from descending neurons (Cheong et al., 2024).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-04-10T09:38:31Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00053082</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>AHN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00053082</oboInOwl:id>
        <rdfs:label>adult ascending histaminergic neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00053082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
