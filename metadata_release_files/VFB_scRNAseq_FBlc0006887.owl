    <!-- http://purl.obolibrary.org/obo/FBbt_00004903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00006010"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00006030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004866"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048548"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0000636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0004606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0010453"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stem cell from which the follicle cells that envelop the germline cyst derive. They develop from the larval follicle stem cell progenitors (Slaidina et al., 2020). There are two follicle stem cells in each germarium, located at opposite sides of the lateral wall of the germarium, in between regions 2a and 2b (Reilein et al., 2017). Each follicle stem cell produces over 500 follicle cells from nine cell divisions (Airoldi et al., 2011).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>SSC</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>somatic stem cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>CL:0000441</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>FSC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelial follicle stem cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004903</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#RD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Can be identified by expression of zfh1, Fas3 and low expression of Wnt4 (Rust et al., 2020).</rdfs:comment>
        <rdfs:label>follicle stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004903"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Stem cell from which the follicle cells that envelop the germline cyst derive. They develop from the larval follicle stem cell progenitors (Slaidina et al., 2020). There are two follicle stem cells in each germarium, located at opposite sides of the lateral wall of the germarium, in between regions 2a and 2b (Reilein et al., 2017). Each follicle stem cell produces over 500 follicle cells from nine cell divisions (Airoldi et al., 2011).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0084162</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0202474</oboInOwl:hasDbXref>
