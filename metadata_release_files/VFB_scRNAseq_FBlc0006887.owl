        <obo:IAO_0000115>The medial lobe of the larval mushroom body. It is associated with appetitive memory (Eschbach et al., 2020).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-01-03T02:51:41Z</dc:date>
