            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Specialized region of the posterior egg/embryo cytoplasm characterized by the presence of non-membrane limited electron dense bodies (polar granules) (Okada, 1998).</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>germ plasm</oboInOwl:hasNarrowSynonym>
