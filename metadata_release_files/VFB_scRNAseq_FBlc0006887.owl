    <!-- http://purl.obolibrary.org/obo/FBbt_00100017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003982"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Antennal mechanosensory and motor center zone C is a synapse rich sub-region of the antennal mechanosensory and motor center (AMMC) that arises from the most lateral half of the bifurcation at the end of the lateral core (LC) bundle (the other half of the bifurcation forms zone D). It is rich in the presynapses of Johnston&apos;s organ neurons (JONs). It is composed of two branches (CM and CL), which merge at their posterior ends (Kamikouchi et al., 2006).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-11-23T04:03:08Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100017</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>AMMC zone C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>JON bundle C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Johnston organ neuron bundle C</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>zone C</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00100017</oboInOwl:id>
        <rdfs:comment>Presence of presynaptic sites determined by immunoreactivity to syntaxin and synaptobrevin::GFP localization (Kamikouchi et al., 2006).</rdfs:comment>
        <rdfs:label>antennal mechanosensory and motor center zone C</rdfs:label>
    </owl:Class>
