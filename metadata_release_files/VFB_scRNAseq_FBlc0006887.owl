    <!-- http://purl.obolibrary.org/obo/FBdv_00005263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBdv_00005263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FBdv_00018001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00004886"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
