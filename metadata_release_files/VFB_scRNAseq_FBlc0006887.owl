        <oboInOwl:hasDbXref>FlyBase:FBrf0245230</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00005790 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005790">
