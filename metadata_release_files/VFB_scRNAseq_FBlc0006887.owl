        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100247"/>
        <obo:IAO_0000115>Gamma Kenyon cell of the larval (or late embryonic) mushroom body. It innervates both (vertical and medial) lobes (Lee et al., 1999; Kunz et al., 2012). It is the first type of Kenyon cell to be produced, and is born in the late embryo or early larva (Lee et al., 1999; Kunz et al., 2012). It is pruned back during early pupal stages to innervate only the gamma lobe of the adult mushroom body (Lee et al., 1999; Truman et al., 2023).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-09-30T12:36:56Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00049827</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>larval gamma KC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval mushroom body gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00049827</oboInOwl:id>
        <rdfs:label>larval gamma Kenyon cell</rdfs:label>
    </owl:Class>
