        <oboInOwl:hasDbXref>FlyBase:FBrf0007732</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00005384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007010"/>
