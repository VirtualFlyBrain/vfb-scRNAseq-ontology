        </rdfs:subClassOf>
        <obo:IAO_0000028>BM-Ant</obo:IAO_0000028>
        <obo:IAO_0000115>Mechanosensory neuron that has its dendrite in an antennal bristle. It follows the antennal nerve and terminates in the subesophageal zone (Eichler et al., 2024). In the brain, it has a contralateral projection (Eichler et al., 2024). There is one of these per antennal bristle (around 20 per side) (Eichler et al., 2024).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-02-08T11:09:26Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00052788</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>BM-Ant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>BM-Ant neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00052788</oboInOwl:id>
        <rdfs:label>mechanosensory neuron of antennal bristle</rdfs:label>
    </owl:Class>
