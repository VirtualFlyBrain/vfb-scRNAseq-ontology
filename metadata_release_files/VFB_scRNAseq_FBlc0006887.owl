            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A synaptic neuropil block in the adult brain that lies anterior and lateral to the central complex, with which it is closely associated. Unlike components of the central complex, it is not separated from surrounding neuropils by a glial sheath.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-12T04:31:57Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00040001</oboInOwl:hasDbXref>
