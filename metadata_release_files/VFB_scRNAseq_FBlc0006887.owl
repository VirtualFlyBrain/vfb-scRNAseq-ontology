                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002134"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007127"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Tract of the larval brain which is connected to the baso-anterior synaptic neuropil domain (BA; antennal compartment). This tract travels along the neuropil glial sheath which forms the boundary between baso-anterior (BA) and baso-central (BC) synaptic neuropil domains. The tract then turns dorsally to make the antennal root of the antenno-cerebral tract (ACT).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00007128</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ABT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00007128</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#larval_OF"/>
        <rdfs:label>antero-basal tract</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007128"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Tract of the larval brain which is connected to the baso-anterior synaptic neuropil domain (BA; antennal compartment). This tract travels along the neuropil glial sheath which forms the boundary between baso-anterior (BA) and baso-central (BC) synaptic neuropil domains. The tract then turns dorsally to make the antennal root of the antenno-cerebral tract (ACT).</owl:annotatedTarget>
