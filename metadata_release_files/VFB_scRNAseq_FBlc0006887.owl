                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00045004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Astrocyte-like (reticular) glial cell with its soma at the surface of either the adult lobula or lobula plate (lobula complex) neuropil regions (Kremer et al., 2017). These cells take many shapes and sizes and may form branches into one or both neuropils (Kremer et al., 2017).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-05-18T12:24:59Z</dc:date>
