        <oboInOwl:id>FBbt:00058272</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>oviduct epithelium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A squamous monolayer epithelium that lines the oviduct. Its cells are joined along their lateral membranes by extensive septate junctions, but lack apical zonal adherens junctions (Kapelnikov et al., 2008).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0207006</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00058273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00058273">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FBbt_00000124"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
