                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0010109"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A neuroblast that is the precursor of the medulla. The neuroblasts that give rise to the outer medulla neurons are located in the medial edge of the larval outer optic anlage, whereas the neuroblasts that give rise to the inner medulla neurons are located in the larval inner optic anlage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00001938</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00001938</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Can be distinguished from other optic lobe neuroblasts based on expression of dpn and ase (Konstantinides et al., 2022).</rdfs:comment>
        <rdfs:label>medulla forming neuroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
