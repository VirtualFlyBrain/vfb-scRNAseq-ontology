        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00049994</oboInOwl:id>
        <rdfs:label>upper tectulum</rdfs:label>
    </owl:Class>
