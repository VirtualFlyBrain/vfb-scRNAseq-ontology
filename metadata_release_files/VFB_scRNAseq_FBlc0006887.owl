                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003624"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Superficial layer of the brain, composed of glia and the cell bodies of neurons (soma).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/466</obo:IAO_0000233>
        <oboInOwl:hasDbXref>VFB:FBbt_00003625</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult brain cortex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cerebral cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00003625</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>Ito et al. (2014) may further subdivide cortex/rind regions into multiple facets. Subdivisions should be denoted by the addition of a single letter body-axis direction, e.g. rLHa for anterior to the lateral horn; rSMPm for medial to the superior medial protocerebrum, etc.</rdfs:comment>
        <rdfs:label>adult brain cell body rind</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003625"/>
