    <!-- http://purl.obolibrary.org/obo/FBbt_00005497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007046"/>
