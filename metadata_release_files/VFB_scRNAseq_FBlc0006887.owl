    <!-- http://purl.obolibrary.org/obo/FBbt_00040072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00040072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Synaptic neuropil domain of the adult brain that is the inferior (ventral) part of the posterior cerebral ganglion, covering the area between the inferior bridge and the gnathal ganglion with its superior part lying behind the ventral complex. It contains extensive arborizations of ascending and descending neurons. Its superior boundary is the level above which such arborizations do not occur. It also contains the terminals of axons from the ocellar ganglia, projecting via the ocellar nerves.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-02-24T03:41:00Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00040072</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>PS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>CMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00040072</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#BrainName"/>
        <rdfs:comment>The ventral complex corresponds to the caudal medial protocerebrum (CMP) and possibly includes part of the ventromedial protocerebrum (VMP) of Chiang et al. (2011) (Ito et al., 2014).</rdfs:comment>
        <rdfs:label>posterior slope</rdfs:label>
        <foaf:depiction>https://cdn.ncbi.nlm.nih.gov/pmc/blobs/acda/10213501/ccb19d89b056/iyad064f6.jpg</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Synaptic neuropil domain of the adult brain that is the inferior (ventral) part of the posterior cerebral ganglion, covering the area between the inferior bridge and the gnathal ganglion with its superior part lying behind the ventral complex. It contains extensive arborizations of ascending and descending neurons. Its superior boundary is the level above which such arborizations do not occur. It also contains the terminals of axons from the ocellar ganglia, projecting via the ocellar nerves.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0212704</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0224194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB_vol:00040072</oboInOwl:hasDbXref>
    </owl:Axiom>
