                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052310"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
