        <oboInOwl:hasDbXref>FlyBase:FBrf0224070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0228639</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0252485</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00013774"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Dm8</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0262545</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL"/>
