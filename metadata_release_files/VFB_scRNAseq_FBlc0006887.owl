    <!-- http://purl.obolibrary.org/obo/FBbt_00100247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003686"/>
        <obo:IAO_0000115>Mushroom body neuron that innervates the mushroom body vertical and medial lobes in the larva, but is pruned back during early pupal stages to innervate only the gamma lobe in the adult (Lee et al., 1999; Awasaki and Ito, 2004; Awasaki et al., 2006; Truman et al., 2023). The gamma neurons are the first born of the Kenyon cells, generated during embryonic and early larval stages (Lee et al., 1999).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-09T04:01:58Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100247</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>KCg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Kenyon cells (gamma lobe)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gamma KC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mushroom body gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100247</oboInOwl:id>
        <rdfs:label>gamma Kenyon cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100247"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mushroom body neuron that innervates the mushroom body vertical and medial lobes in the larva, but is pruned back during early pupal stages to innervate only the gamma lobe in the adult (Lee et al., 1999; Awasaki and Ito, 2004; Awasaki et al., 2006; Truman et al., 2023). The gamma neurons are the first born of the Kenyon cells, generated during embryonic and early larval stages (Lee et al., 1999).</owl:annotatedTarget>
