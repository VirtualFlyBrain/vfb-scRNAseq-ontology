        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00047310</oboInOwl:id>
        <rdfs:label>mushroom body slice</rdfs:label>
    </owl:Class>
