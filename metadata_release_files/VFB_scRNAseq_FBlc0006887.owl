                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00016005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Anterior length of the salivary gland duct. Anteriorly it connects to the atrium of the foregut. Posteriorly it bifurcates into the ducts of the individual salivary glands (Skaer, 1993).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00005775</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>larval salivary gland common duct</oboInOwl:hasExactSynonym>
