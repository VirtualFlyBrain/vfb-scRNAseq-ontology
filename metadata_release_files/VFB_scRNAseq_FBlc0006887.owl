    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007008"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007046"/>
