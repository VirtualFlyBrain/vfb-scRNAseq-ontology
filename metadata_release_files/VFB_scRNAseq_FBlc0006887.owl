    <!-- http://purl.obolibrary.org/obo/FBbt_00005127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007577"/>
        <obo:IAO_0000115>Optic lobe intrinsic neuron without defined axons or dendrites, having processes with mixed pre- and post-synapses in approximately the same ratio throughout the cell (Matsliah et al., 2024). Some amacrine cells, such as CT1, have multiple compartmentalized, modular arborizations (Meier and Borst, 2019).</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>amacrine cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>VFB:FBbt_00005127</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00005127</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>optic lobe amacrine neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Optic lobe intrinsic neuron without defined axons or dendrites, having processes with mixed pre- and post-synapses in approximately the same ratio throughout the cell (Matsliah et al., 2024). Some amacrine cells, such as CT1, have multiple compartmentalized, modular arborizations (Meier and Borst, 2019).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0049410</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0242197</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0260545</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00005129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052046"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0013001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003701"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Interneuron of the optic lobe whose primary projection extends along the long axis of a single optic column to which it, but not necessarily its collaterals, is restricted.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00005129</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00005129</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>This definition follows Fischbach and Dittrich (1989) in classifying based on the primary projection. A neuron with broad and extensive collaterals with terminals in adjacent columns is still classified as a columnar neuron under this definition. Other treatments have classified such neurons as tangential.</rdfs:comment>
        <rdfs:label>adult optic lobe columnar neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005129"/>
