        <oboInOwl:hasExactSynonym>posterior midgut rudiment</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>P2 postEndo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>postEndo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>postEndoP2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>postMGRudP2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior endoderm primordium P2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior midgut primordium rudiment</oboInOwl:hasRelatedSynonym>
