        <obo:IAO_0000115>The last stage of oogenesis. This stage begins when no nurse cell nuclei remain at the anterior of the egg (chamber). Exochorion formation and secretion occurs during this stage. The dorsal appendages complete their elongation and the follicle cells die.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005283</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 10260.</rdfs:comment>
        <rdfs:label>oogenesis stage S14</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The last stage of oogenesis. This stage begins when no nurse cell nuclei remain at the anterior of the egg (chamber). Exochorion formation and secretion occurs during this stage. The dorsal appendages complete their elongation and the follicle cells die.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0043885</oboInOwl:hasDbXref>
    </owl:Axiom>
    


