    <!-- http://purl.obolibrary.org/obo/FBbt_00007089 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00007089">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002371"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007091"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The outermost cellular layer of the nervous system, probably of mesodermal origin (Hartenstein and Jan, 1992). This layer consists of glial cells, which participate in nutrient uptake and establish a first diffusion barrier (Limmer et al., 2014).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1338</obo:IAO_0000233>
        <oboInOwl:hasDbXref>VFB:FBbt_00007089</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>apical glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perineural sheath</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>perineurial sheath</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>neural lamella</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00007089</oboInOwl:id>
        <rdfs:comment>Evidence of mesodermal origin comes from the observation that embryos lacking mesoderm lack this cell layer and the overlying neural lamella (Edwards et al., 1993).</rdfs:comment>
        <rdfs:label>perineurial glial sheath</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The outermost cellular layer of the nervous system, probably of mesodermal origin (Hartenstein and Jan, 1992). This layer consists of glial cells, which participate in nutrient uptake and establish a first diffusion barrier (Limmer et al., 2014).</owl:annotatedTarget>
