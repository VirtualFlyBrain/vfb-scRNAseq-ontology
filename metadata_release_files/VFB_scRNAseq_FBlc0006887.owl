            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Epithelial cell of the oviduct. It has convoluted intracellular membranous structures and extensive microvilli, suggestive of a role in secretion (Middleton et al., 2006).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-6095-8718"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-01T10:09:16Z</dc:date>
