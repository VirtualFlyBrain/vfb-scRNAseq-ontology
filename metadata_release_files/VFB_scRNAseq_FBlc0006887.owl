    <!-- http://purl.obolibrary.org/obo/FBbt_00051440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005495"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001925"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002203"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003682"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Primordium that will give rise to the bulb (Lovick et al., 2017). It is located in the larval anterior inferior protocerebrum, posteriorly adjacent to the medial lobe of the mushroom body (Lovick et al., 2017). The superior and inferior regions of the bulb have distinct primordia formed by the two different lineages of TuBu neurons (Lovick et al., 2017). The DALv2 lineage neurons also contribute to the bulb primordium (Lovick et al., 2017).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-17T14:52:04Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051440</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>BU primordium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00051440</oboInOwl:id>
        <rdfs:label>bulb primordium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Primordium that will give rise to the bulb (Lovick et al., 2017). It is located in the larval anterior inferior protocerebrum, posteriorly adjacent to the medial lobe of the mushroom body (Lovick et al., 2017). The superior and inferior regions of the bulb have distinct primordia formed by the two different lineages of TuBu neurons (Lovick et al., 2017). The DALv2 lineage neurons also contribute to the bulb primordium (Lovick et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0236656</oboInOwl:hasDbXref>
    </owl:Axiom>
