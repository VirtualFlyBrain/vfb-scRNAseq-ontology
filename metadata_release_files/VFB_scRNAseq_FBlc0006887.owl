            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The endocrine complex which consists of the corpus cardiacum and corpus allatum (Hartenstein, 2006; Lee et al., 2008).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0012325</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>CC-CA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retrocerebral neuroendocrine complex</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00001718</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>This is the common part of the adult (CA, CC, HG) and larval (CA, CC, PG) ring glands, but terminology seems to be very rarely used for the larva - https://orcid.org/0000-0002-1373-1705.</rdfs:comment>
        <rdfs:label>retrocerebral complex</rdfs:label>
    </owl:Class>
