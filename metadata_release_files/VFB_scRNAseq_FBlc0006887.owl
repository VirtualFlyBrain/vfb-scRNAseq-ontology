    <!-- http://purl.obolibrary.org/obo/FBbt_00003726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003922"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Intrinsic columnar neuron of the optic lobe that has its cell body in the posterior part of the optic lobe and a cell body fiber that bifurcates in the second optic chiasma (Fischbach and Dittrich, 1989). It has two branches, each targeting a different neuropil adjacent to the second optic chiasma (lobula, lobula plate and medulla) (Fischbach and Dittrich, 1989).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00003726</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>T</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00003726</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>T neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Intrinsic columnar neuron of the optic lobe that has its cell body in the posterior part of the optic lobe and a cell body fiber that bifurcates in the second optic chiasma (Fischbach and Dittrich, 1989). It has two branches, each targeting a different neuropil adjacent to the second optic chiasma (lobula, lobula plate and medulla) (Fischbach and Dittrich, 1989).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0049410</oboInOwl:hasDbXref>
    </owl:Axiom>
    


