                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005893"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002101"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00002037"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Larval sensory neuron that fasciculates with a segmental nerve. In abdominal segments 1-7, these are the sensory neurons located in the ventral and ventral&apos; clusters (Campos-Ortega and Hartenstein, 1997; Singhania and Grueber, 2014).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00002038</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>posterior fascicle sensory neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00002038</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>larval segmental nerve sensory neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00002038"/>
