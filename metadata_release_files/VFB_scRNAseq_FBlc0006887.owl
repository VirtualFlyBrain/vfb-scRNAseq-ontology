        <oboInOwl:hasExactSynonym>larval mushroom body alpha&apos;/beta&apos; neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval mushroom body alpha-prime/beta-prime Kenyon cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval mushroom body alpha-prime/beta-prime neuron</oboInOwl:hasExactSynonym>
