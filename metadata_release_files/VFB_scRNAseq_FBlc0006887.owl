            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00110684"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Unpaired duct that connects the male accessory glands and vasa deferentia to the aedeagus in the adult male genitalia. It is divided in an anterior ejaculatory duct and a posterior ejaculatory duct, separated by the ejaculatory bulb (Miller, 1941).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004965</oboInOwl:id>
