    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBdv_00005344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/FBdv_00018001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005342"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
