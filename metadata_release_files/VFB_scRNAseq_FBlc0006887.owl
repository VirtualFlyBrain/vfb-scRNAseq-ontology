        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>dorsal ectoderm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00000112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Dorsal region of the ectoderm. It forms parts of the larval epidermis and the tracheal system, with other parts of these contributed to by the lateral ectoderm (Stathopoulos and Newcomb, 2020).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0244630</oboInOwl:hasDbXref>
