    <!-- http://purl.obolibrary.org/obo/FBbt_00040043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00040043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An aglomerular, bilaterally paired synaptic neuropil domain of the adult ventrolateral protocerebrum (VLP) that protrudes from the anterior brain between the optic lobe and the antennal lobe. It is located in front of the posterior VLP and below the anterior optic tubercle and superior clamp. It receives input from neurons projecting from the optic lobe.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-13T04:16:39Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00040043</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>AVLP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anterior VLP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00040043</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#BrainName"/>
        <rdfs:label>anterior ventrolateral protocerebrum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An aglomerular, bilaterally paired synaptic neuropil domain of the adult ventrolateral protocerebrum (VLP) that protrudes from the anterior brain between the optic lobe and the antennal lobe. It is located in front of the posterior VLP and below the anterior optic tubercle and superior clamp. It receives input from neurons projecting from the optic lobe.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0224194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VFB_vol:00040043</oboInOwl:hasDbXref>
