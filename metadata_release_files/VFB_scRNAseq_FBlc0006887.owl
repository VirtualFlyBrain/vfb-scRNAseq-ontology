            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The primordium of the gonadal sheath. This arises from clusters of cells in parasegments 10, 11 and 12 of the dorsal branch of the fat body/gonad primordium which split off during stage 14 and then cluster around the germ cells.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>SGP</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>somatic gonadal precursor</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>gonadal mesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gonadal sheath specific anlage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00005473</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>gonadal sheath proper primordium</rdfs:label>
    </owl:Class>
