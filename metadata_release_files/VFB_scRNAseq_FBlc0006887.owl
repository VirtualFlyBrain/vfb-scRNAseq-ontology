        </rdfs:subClassOf>
        <obo:IAO_0000115>Local neuron of the ocellar ganglia (Dorkenwald et al., 2024; Schlegel et al., 2024). It is a small neuron that connects sparsely with photoreceptors from all ocelli (Dorkenwald et al., 2024; Schlegel et al., 2024). There are approximately 16 of these per organism (Dorkenwald et al., 2024; Schlegel et al., 2024).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-02-12T16:40:27Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00052815</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00052815</oboInOwl:id>
        <rdfs:label>ocellar ganglion local neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Local neuron of the ocellar ganglia (Dorkenwald et al., 2024; Schlegel et al., 2024). It is a small neuron that connects sparsely with photoreceptors from all ocelli (Dorkenwald et al., 2024; Schlegel et al., 2024). There are approximately 16 of these per organism (Dorkenwald et al., 2024; Schlegel et al., 2024).</owl:annotatedTarget>
