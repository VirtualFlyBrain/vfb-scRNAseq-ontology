        <obo:IAO_0000028>MeTu</obo:IAO_0000028>
        <obo:IAO_0000115>Neuron that connects the medulla to the anterior optic tubercle (AOTU), via the anterior optic tract, innervating the small unit of the AOTU (Timaeus et al., 2020; Hulse et al., 2021; Kandimalla et al., 2023). It is derived from an optic neuroblast (Kandimalla et al., 2023). There are around 500 of these cells per hemisphere (Nern et al., 2025).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-04-22T11:23:51Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051228</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>MT neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MeTu</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MeTu neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult medullar-tubercular neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medullo-tubercular neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00051228</oboInOwl:id>
        <rdfs:label>adult medulla-tubercle neuron</rdfs:label>
    </owl:Class>
