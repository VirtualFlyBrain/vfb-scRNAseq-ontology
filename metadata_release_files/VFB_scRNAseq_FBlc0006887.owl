        <oboInOwl:id>FBbt:00049284</oboInOwl:id>
        <rdfs:comment>Can be identified by expression of Piezo (He et al., 2018).</rdfs:comment>
        <rdfs:label>adult enteroendocrine precursor cell</rdfs:label>
    </owl:Class>
