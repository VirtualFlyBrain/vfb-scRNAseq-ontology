    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00047836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001303"/>
        <obo:IAO_0000115>Polarized glial cell with a flattened cell body that forms a sheath around the synaptic and tract neuropil regions (Hartenstein, 2011; Pogodalla et al., 2021). They may serve a homologous function to the wrapping glia, which ensheath the peripheral nerves (Kremer et al., 2017).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-17T09:16:04Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00047836</oboInOwl:hasDbXref>
