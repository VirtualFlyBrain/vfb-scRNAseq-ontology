            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Primordium which is formed by the delamination of neuroblasts from the ventral neurogenic region. The first of five waves of delamination starts towards the end of embryonic stage 8. During stage 11, the mesectoderm loses contact with the outer surface and forms neuronal and glial precursors in the midline of this primordium.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00000115</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>FBbt:00005430</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>AvenNeur</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>P3 venNeur</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>venNeurP3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral neurectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral neuroderm primordium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral neuroectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00005554</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#EmbDevSlim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>ventral nerve cord primordium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Primordium which is formed by the delamination of neuroblasts from the ventral neurogenic region. The first of five waves of delamination starts towards the end of embryonic stage 8. During stage 11, the mesectoderm loses contact with the outer surface and forms neuronal and glial precursors in the midline of this primordium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0089570</oboInOwl:hasDbXref>
    </owl:Axiom>
