            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oogenesis stage that begins when the nurse cells chromosomes become bulbous. Nurse cell chromosomes during this stage are polytene and reach a ploidy of 32C. The egg chamber is oval shaped.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005264</oboInOwl:id>
