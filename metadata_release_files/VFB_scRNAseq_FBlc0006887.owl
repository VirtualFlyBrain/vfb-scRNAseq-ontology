    <!-- http://purl.obolibrary.org/obo/FBbt_00111302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00111302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001297"/>
        <obo:IAO_0000115>Surface-associated glial cell of the optic lobe that is part of a layer found below the perineurial and subperineurial optic lobe glia (Morante et al., 2013). These cells can be identified by their relatively large nuclei and are found from third instar through to adult stages (Morante et al., 2013). They are cell body glial cells (Morante et al., 2013; Plazaola-Sasieta et al., 2019).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-11-28T12:30:04Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00111302</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>optic lobe surface-associated cortex glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00111302</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>optic-lobe-associated cortex glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00111302"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Surface-associated glial cell of the optic lobe that is part of a layer found below the perineurial and subperineurial optic lobe glia (Morante et al., 2013). These cells can be identified by their relatively large nuclei and are found from third instar through to adult stages (Morante et al., 2013). They are cell body glial cells (Morante et al., 2013; Plazaola-Sasieta et al., 2019).</owl:annotatedTarget>
