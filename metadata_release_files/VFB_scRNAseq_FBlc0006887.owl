        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>MT tract</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0248513</oboInOwl:hasDbXref>
    </owl:Axiom>
    


