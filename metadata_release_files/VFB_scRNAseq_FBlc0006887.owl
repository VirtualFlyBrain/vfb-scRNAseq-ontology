        <oboInOwl:hasExactSynonym>vNR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral neurectoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ventral neurogenic region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>neurectoderm</oboInOwl:hasRelatedSynonym>
