        <oboInOwl:hasExactSynonym>vertical triangle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004495</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>The ocellar triangle does not correspond to a separate sclerite (Ferris, 1950).</rdfs:comment>
        <rdfs:label>ocellar triangle</rdfs:label>
    </owl:Class>
