        <oboInOwl:hasExactSynonym>embryonic Bolwig&apos;s organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic visual system</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval Bolwig&apos;s organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval eye</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stemmata organ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>dorsocaudal pharyngeal sense organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00005805</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#FB_gloss"/>
