        <obo:IAO_0000115>A subdivision of the cell body rind of the central nervous system. It includes the neuronal cell bodies.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-09-08T02:26:08Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100200</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cell body layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cortex region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100200</oboInOwl:id>
        <rdfs:comment>Ito et al. (2014) may further subdivide cortex/rind regions into multiple facets. Subdivisions should be denoted by the addition of a single letter body-axis direction, e.g. rLHa for anterior to the lateral horn; rSMPm for medial to the superior medial protocerebrum, etc.</rdfs:comment>
        <rdfs:label>cell body rind region</rdfs:label>
    </owl:Class>
