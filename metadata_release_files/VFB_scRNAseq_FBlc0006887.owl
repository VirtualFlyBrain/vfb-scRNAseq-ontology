        <oboInOwl:hasExactSynonym>medulla intrinsic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>medullary intrinsic columnar neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003775</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>medulla intrinsic columnar neuron</rdfs:label>
    </owl:Class>
