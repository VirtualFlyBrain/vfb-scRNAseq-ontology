    <!-- http://purl.obolibrary.org/obo/FBbt_00000449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00000449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001886"/>
