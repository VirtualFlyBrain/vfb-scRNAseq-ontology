                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007401"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A short axon tract containing only a few fibers which projects from the posterior of the antennal lobe, just ventral to the medial antennal lobe tract. Fibers from this tract pass into posterior brain areas, e.g. into the region of the great commissure.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00003987</oboInOwl:hasDbXref>
