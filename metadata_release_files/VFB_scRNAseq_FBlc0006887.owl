                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00052052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Ventral portion of the epigynium below the epigynial dorsal lobe (McQueen et al., 2022). There are two of these per organism, one on each side (McQueen et al., 2022). Each lobe (left and right) normally harbors four or five small, unpigmented sensilla (bristles) (McQueen et al., 2022).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-01-18T11:52:58Z</dc:date>
