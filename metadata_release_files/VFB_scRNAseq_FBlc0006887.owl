                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PATO_0000618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Local interneuron of the adult antennal lobe that innervates only the ipsilateral and contralateral antennal lobes.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-09-03T15:18:45Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00110635</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>bilaterally projecting LN</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00110635</oboInOwl:id>
        <rdfs:comment>Tanaka et al (2012) distinguishes four different types (LN3-6) based mainly on their innervation patterns. LN3 neurons innervate all glomeruli, LN4 innervate a few posterior glomeruli, LN5 innervate only one glomeruli and LN6 neurons innervate almost all the glomeruli and their cell bodies are located in the cell body rind of the gnathal ganglion.</rdfs:comment>
        <rdfs:label>bilateral local interneuron of the adult antennal lobe</rdfs:label>
    </owl:Class>
