    <!-- http://purl.obolibrary.org/obo/FBbt_00005634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00005634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005786"/>
        <rdfs:subClassOf>
            <owl:Restriction>
