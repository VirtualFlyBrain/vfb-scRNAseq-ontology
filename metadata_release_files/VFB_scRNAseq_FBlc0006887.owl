    <!-- http://purl.obolibrary.org/obo/FBbt_00001881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00025993"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001880"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
