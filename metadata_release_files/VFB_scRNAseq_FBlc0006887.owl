        <obo:IAO_0000115>Embryonic stages 16-17.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005333</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 370.</rdfs:comment>
        <rdfs:label>late embryonic stage</rdfs:label>
    </owl:Class>
