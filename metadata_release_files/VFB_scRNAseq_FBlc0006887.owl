            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Distal sublayer of the medulla layer M6, proximal to layer M5. It is defined by the extent of the arborization of Dm8 neurons proximally.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2015-11-10T14:00:27Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00111269</oboInOwl:hasDbXref>
