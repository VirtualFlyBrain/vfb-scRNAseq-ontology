    <!-- http://purl.obolibrary.org/obo/FBbt_00003125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
