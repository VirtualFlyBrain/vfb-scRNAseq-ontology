                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001939"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Lateral-most synaptic neuropil domain of the adult optic lobes, lying just beneath the compound eyes. It is composed of an array of repetitive cartridge-like units, each of which receives axons from specific sets of ommatidia in the compound eyes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00003708</oboInOwl:hasDbXref>
