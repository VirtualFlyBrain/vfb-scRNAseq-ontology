        <oboInOwl:hasExactSynonym>adult dopaminergic GNG neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult dopaminergic SB neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult dopaminergic SOG neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00048266</oboInOwl:id>
        <rdfs:label>adult dopaminergic neuron of gnathal ganglion</rdfs:label>
    </owl:Class>
