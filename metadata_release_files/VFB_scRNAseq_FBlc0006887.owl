    <!-- http://purl.obolibrary.org/obo/FBbt_00001951 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007676"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002203"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001944"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002203"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001946"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00000461"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A ribbon-like layer of neuroepithelial cells (and later of proliferating neuroblasts) in the larval optic lobe that gives rise to the adult inner medulla, lobula and lobula plate neurons. In early larval stages it is composed of neuroepithelial cells that divide symmetrically. In the early second instar it becomes U shaped, with the opening of the U pointing in a dorso-caudal direction. It becomes distinguished from the outer optic anlage during the second half of the first instar period (Meinertzhagen and Hanson, 1993). In the third instar, neuroepithelial cells in the medial region give rise to neuroblasts that divide asymmetrically to generate the adult optic lobe neurons.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00001951</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>IOA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval inner optic anlage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>IPC</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>inner proliferation center</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00001951</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:comment>&apos;proliferation center&apos; synonyms usually used for later stages of development (Ngo et al., 2017 - FBrf0236058).</rdfs:comment>
        <rdfs:label>larval inner optic anlage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001951"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A ribbon-like layer of neuroepithelial cells (and later of proliferating neuroblasts) in the larval optic lobe that gives rise to the adult inner medulla, lobula and lobula plate neurons. In early larval stages it is composed of neuroepithelial cells that divide symmetrically. In the early second instar it becomes U shaped, with the opening of the U pointing in a dorso-caudal direction. It becomes distinguished from the outer optic anlage during the second half of the first instar period (Meinertzhagen and Hanson, 1993). In the third instar, neuroepithelial cells in the medial region give rise to neuroblasts that divide asymmetrically to generate the adult optic lobe neurons.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0052913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0193624</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001951"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>IOA</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0204205</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001951"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>IPC</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0095642</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001951"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>inner proliferation center</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0095642</oboInOwl:hasDbXref>
    </owl:Axiom>
    


