    <!-- http://purl.obolibrary.org/obo/FBbt_00001061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001057"/>
