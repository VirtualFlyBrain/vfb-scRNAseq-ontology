                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002134"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002134"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Neuron projection bundle containing the axons of Johnston&apos;s organ neurons (JONs) that arises from the final, most posterior bifurcation of the main trunk of the antennal mechanosensory and motor center (AMMC). (The other bundle arising from this bifurcation is the EA region of the AMMC). The lateral core is devoid of presynaptic sites. It terminates in a bifurcation that gives rise to the synapse rich AMMC zones C and D.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-12-04T04:01:02Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100007</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>JON-LC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lateral core of AMMC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lateral core region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100007</oboInOwl:id>
        <rdfs:comment>That the lateral core of AMMC lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization (Kamikouchi et al., 2006).</rdfs:comment>
        <rdfs:label>lateral core of antennal mechanosensory and motor center</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Neuron projection bundle containing the axons of Johnston&apos;s organ neurons (JONs) that arises from the final, most posterior bifurcation of the main trunk of the antennal mechanosensory and motor center (AMMC). (The other bundle arising from this bifurcation is the EA region of the AMMC). The lateral core is devoid of presynaptic sites. It terminates in a bifurcation that gives rise to the synapse rich AMMC zones C and D.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0194812</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100007"/>
