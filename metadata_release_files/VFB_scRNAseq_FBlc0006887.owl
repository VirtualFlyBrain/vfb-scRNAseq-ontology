    <!-- http://purl.obolibrary.org/obo/FBbt_00052058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00052058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004475"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00048491"/>
