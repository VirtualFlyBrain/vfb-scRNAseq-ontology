        </rdfs:subClassOf>
        <obo:IAO_0000115>Enteroendocrine cell of the adult midgut expressing the hormone sNPF. These cells are found in the region R2 of the anterior midgut (Guo et al., 2019).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-6095-8718"/>
