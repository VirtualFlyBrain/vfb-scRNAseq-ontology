            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Adepithelial cell associated with the wing imaginal disc. There are approximately 10 of these cells per wing disc at the end of embryogenesis; they proliferate throughout the larval stages to reach up to 2,500 cells by the late third instar larval stage. They give rise to the direct and indirect flight muscles of the adult (Gunage et al., 2014).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FBbt:00100786</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>adepithelial cell of dorsal mesothoracic disc</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult flight muscle precursor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00003225</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>adepithelial cell of wing disc</rdfs:label>
    </owl:Class>
    <owl:Axiom>
