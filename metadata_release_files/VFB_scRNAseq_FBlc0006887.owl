    <!-- http://www.bioassayontology.org/bao#BAO_0000509 -->

    <owl:Class rdf:about="http://www.bioassayontology.org/bao#BAO_0000509">
        <rdfs:subClassOf rdf:resource="http://www.bioassayontology.org/bao#BAO_0000658"/>
        <obo:IAO_0000115>This includes fungi, vertebrates and invertebrates. Eukaryotic cells have a well-defined nucleus and membrane enveloped organelles namely, mitochondria, endoplasmic reticulum, golgi apparatus, and lysosomes.</obo:IAO_0000115>
        <rdfs:label>eukaryote</rdfs:label>
    </owl:Class>
    


    <!-- http://www.bioassayontology.org/bao#BAO_0000511 -->

    <owl:Class rdf:about="http://www.bioassayontology.org/bao#BAO_0000511">
        <rdfs:subClassOf rdf:resource="http://www.bioassayontology.org/bao#BAO_0000659"/>
        <obo:IAO_0000115>These animals lack a vertebral column and many of which are used as model organisms in HTS screening including Drosophila, C.elegans, sea urchin, etc.</obo:IAO_0000115>
        <rdfs:label>invertebrate</rdfs:label>
    </owl:Class>
    


    <!-- http://www.bioassayontology.org/bao#BAO_0000551 -->

    <owl:Class rdf:about="http://www.bioassayontology.org/bao#BAO_0000551">
        <rdfs:subClassOf rdf:resource="http://www.bioassayontology.org/bao#BAO_0003114"/>
        <obo:IAO_0000115>The organism related to the target / meta-target of the bioassay. It includes both bacterium and eukaryote.</obo:IAO_0000115>
        <rdfs:label>organism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.bioassayontology.org/bao#BAO_0000658 -->

    <owl:Class rdf:about="http://www.bioassayontology.org/bao#BAO_0000658">
        <rdfs:subClassOf rdf:resource="http://www.bioassayontology.org/bao#BAO_0000551"/>
        <obo:IAO_0000115>This includes all organisms which are made up of cells, e.g. bacteria, plants and animals.</obo:IAO_0000115>
        <rdfs:label>cellular organisms</rdfs:label>
