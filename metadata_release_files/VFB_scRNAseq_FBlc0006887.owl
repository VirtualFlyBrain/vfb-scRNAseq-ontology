    <!-- http://purl.obolibrary.org/obo/FBbt_00051443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005495"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001920"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002203"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003678"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Primordium of the ellipsoid body in the larval brain (Lovick et al., 2017). An anterior part contains the filopodia of the developing R-neurons (lineage DALv2) and a posterior part is formed by the developing columnar neurons of the central complex (lineages DM1-4) (Lovick et al., 2017). These two parts merge during metamorphosis (Lovick et al., 2017).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-08-17T15:27:00Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051443</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>larvalbrain_neuropil:397</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>larvalbrain_neuropil:575</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>primordium of the EB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00051443</oboInOwl:id>
        <rdfs:label>ellipsoid body primordium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051443"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Primordium of the ellipsoid body in the larval brain (Lovick et al., 2017). An anterior part contains the filopodia of the developing R-neurons (lineage DALv2) and a posterior part is formed by the developing columnar neurons of the central complex (lineages DM1-4) (Lovick et al., 2017). These two parts merge during metamorphosis (Lovick et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0236656</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051443"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>primordium of the EB</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0236656</oboInOwl:hasDbXref>
