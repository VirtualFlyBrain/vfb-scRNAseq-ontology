                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005306"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Cellularization. Stage 5 begins when cellularization starts. Near the end of this stage the pole cells begin to migrate dorsally and ventral midline cells acquire an irregular, wavy appearance. Stage 5 ends when ventral furrow formation becomes apparent. Duration at 25 degrees: approximately 40 minutes (130-170 minutes after egg laying).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cellular blastoderm stage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005311</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 210.</rdfs:comment>
        <rdfs:label>embryonic stage 5</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cellularization. Stage 5 begins when cellularization starts. Near the end of this stage the pole cells begin to migrate dorsally and ventral midline cells acquire an irregular, wavy appearance. Stage 5 ends when ventral furrow formation becomes apparent. Duration at 25 degrees: approximately 40 minutes (130-170 minutes after egg laying).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0089570</oboInOwl:hasDbXref>
    </owl:Axiom>
