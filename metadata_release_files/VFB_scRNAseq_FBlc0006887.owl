                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005343"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Male gonads become less distinct. Oral armature stops moving permanently. Dorsal medial abdominal contractions stop. Gas bubble becomes visible within abdomen. Duration at 25 degrees C: approximately 100 minutes. (120.3-122 hours after egg laying; 0.3-2 hours after puparium formation).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>brown puparium stage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pupal stage P2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005344</oboInOwl:id>
        <rdfs:comment>Temporal ordering number - 520.</rdfs:comment>
        <rdfs:label>prepupal stage P2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005344"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Male gonads become less distinct. Oral armature stops moving permanently. Dorsal medial abdominal contractions stop. Gas bubble becomes visible within abdomen. Duration at 25 degrees C: approximately 100 minutes. (120.3-122 hours after egg laying; 0.3-2 hours after puparium formation).</owl:annotatedTarget>
