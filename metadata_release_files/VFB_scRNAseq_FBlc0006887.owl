    <!-- http://purl.obolibrary.org/obo/FBbt_00003627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005140"/>
