    <!-- http://purl.obolibrary.org/obo/FBbt_00001393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00001393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005146"/>
        <obo:IAO_0000115>A neuroblast delaminating in the third wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic stage 10 and end during stage 11, and the neuroblasts generally delaminate into the medial and lateral edge of the neuroblast array (Doe, 1992).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00001393</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>S3 NB</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>S3 neuroblast</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SIII neuroblast</oboInOwl:hasRelatedSynonym>
