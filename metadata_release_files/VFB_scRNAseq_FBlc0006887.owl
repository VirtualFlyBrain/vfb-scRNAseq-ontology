    <!-- http://purl.obolibrary.org/obo/FBdv_00005293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBdv_00005293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005259"/>
