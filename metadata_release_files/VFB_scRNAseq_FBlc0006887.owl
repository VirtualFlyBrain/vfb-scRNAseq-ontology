    <!-- http://purl.obolibrary.org/obo/FBbt_00100482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003870"/>
