    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00111638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005903"/>
        <obo:IAO_0000115>Longitudinal fascicle of the larval ventral nerve cord found in a central position on the dorsal-ventral axis and an intermediate position on the medial-lateral axis (Landgraf et al., 2003). This fascicle is loosely organized, and contains three distinct tracts, the C1, C2 and C3 fascicles (Landgraf et al., 2003; Zlatic et al., 2003).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2016-05-04T12:12:57Z</dc:date>
