    <!-- http://purl.obolibrary.org/obo/FBbt_00051493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005125"/>
        <obo:IAO_0000115>Neuron of the central nervous system that has the majority of its inputs and outputs in close proximity within the same region of the neuropil. Some arbors may spread outside of the region, but without sufficient polarity to define the neuron as an input or output neuron.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/FlyBase/drosophila-anatomy-developmental-ontology/issues/1227</obo:IAO_0000233>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-09-22T08:47:38Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051493</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>local interneuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00051493</oboInOwl:id>
        <rdfs:label>local neuron</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Neuron of the central nervous system that has the majority of its inputs and outputs in close proximity within the same region of the neuropil. Some arbors may spread outside of the region, but without sufficient polarity to define the neuron as an input or output neuron.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0232785</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0242477</oboInOwl:hasDbXref>
