        <obo:IAO_0000115>Inferior (ventral) part of the clamp, between the pedunculus and the central complex. It is located below the superior ellipsoid commissure (SEC) and superior arch commissure (SAC).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-08-13T04:53:17Z</dc:date>
