    <!-- http://purl.obolibrary.org/obo/FBbt_00004242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00004242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005163"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007251"/>
