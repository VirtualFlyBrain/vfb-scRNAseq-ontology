        <oboInOwl:hasDbXref>FlyBase:FBrf0221438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0248215</oboInOwl:hasDbXref>
    </owl:Axiom>
