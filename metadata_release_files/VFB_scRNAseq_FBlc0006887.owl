    <!-- http://purl.obolibrary.org/obo/FBbt_00040050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00040050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
