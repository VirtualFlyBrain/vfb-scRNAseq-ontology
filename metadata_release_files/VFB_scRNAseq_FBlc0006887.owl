        <oboInOwl:hasExactSynonym>adult central brain cortex associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>adult central brain cortex glial cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00049489</oboInOwl:id>
        <rdfs:label>adult central brain cell body glial cell</rdfs:label>
    </owl:Class>
