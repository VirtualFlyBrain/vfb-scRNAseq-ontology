    <!-- http://purl.obolibrary.org/obo/FBbt_00100507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100507">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FBbt_00005144"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003624"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007091"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007605"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058254"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100500"/>
        <obo:IAO_0000115>Glial cell of the subperineurial glial sheath in the adult brain. These cells are fairly uniform in morphology across the brain, having a large, square and thin shape, giving them a sheet-like appearance (Awasaki et al., 2008, Kremer et al., 2017). Some also have circular protrusions that cap neuronal cell bodies not fully enclosed by cell body glia (Kremer et al., 2017).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-04-27T11:06:24Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100507</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult brain SPG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult brain subperineurial surface associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>adult brain basal glial cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>adult brain subperineurial glia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00100507</oboInOwl:id>
        <rdfs:label>adult brain subperineurial glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100507"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell of the subperineurial glial sheath in the adult brain. These cells are fairly uniform in morphology across the brain, having a large, square and thin shape, giving them a sheet-like appearance (Awasaki et al., 2008, Kremer et al., 2017). Some also have circular protrusions that cap neuronal cell bodies not fully enclosed by cell body glia (Kremer et al., 2017).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0206543</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0210316</oboInOwl:hasDbXref>
    </owl:Axiom>
