        <oboInOwl:hasExactSynonym>KCg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult gamma KC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult mushroom body gamma neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00049828</oboInOwl:id>
        <rdfs:label>adult gamma Kenyon cell</rdfs:label>
    </owl:Class>
