    <!-- http://purl.obolibrary.org/obo/FBbt_00007705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00007705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007702"/>
        <obo:IAO_0000115>A ventro-laterally located longitudinal subdivision of the larval central nervous system spanning the gnathal, thoracic and abdominal neuromeres (Hartenstein et al., 2018). It is found at the same level as the ventromedial domain; ventral to the central domain (which contains the C1-3 fascicles) and the centrolateral domain (Hartenstein et al., 2018). Its medial boundary (with the ventromedial domain) is defined by the entry points of lineages 3,5,6 and 12 into the neuropil, which are at the same medio-lateral position as the C1-3 fascicles (Hartenstein et al., 2018). Anteriorly, it terminates posterior to the tritocerebrum, as the CITd and CITv (C1-3 fascicles) reach the lateral edge of the neuropil (Hartenstein et al., 2018). In thoracic neuromeres, this domain becomes enlarged during development and will give rise to the adult leg neuropils (Hartenstein et al., 2018).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-22T14:05:07Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00007705</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>larval ventrolateral neuropil domain</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ventrolateral subdivision of ventral nerve cord</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00007705</oboInOwl:id>
        <rdfs:label>ventrolateral domain of larval central nervous system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A ventro-laterally located longitudinal subdivision of the larval central nervous system spanning the gnathal, thoracic and abdominal neuromeres (Hartenstein et al., 2018). It is found at the same level as the ventromedial domain; ventral to the central domain (which contains the C1-3 fascicles) and the centrolateral domain (Hartenstein et al., 2018). Its medial boundary (with the ventromedial domain) is defined by the entry points of lineages 3,5,6 and 12 into the neuropil, which are at the same medio-lateral position as the C1-3 fascicles (Hartenstein et al., 2018). Anteriorly, it terminates posterior to the tritocerebrum, as the CITd and CITv (C1-3 fascicles) reach the lateral edge of the neuropil (Hartenstein et al., 2018). In thoracic neuromeres, this domain becomes enlarged during development and will give rise to the adult leg neuropils (Hartenstein et al., 2018).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0237252</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007705"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>larval ventrolateral neuropil domain</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0237252</oboInOwl:hasDbXref>
    </owl:Axiom>
    


