        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100505"/>
        <obo:IAO_0000115>Astrocyte-like glial cell of the embryonic/larval central nervous system. There are approximately 15 of these cells in each brain hemisphere (Omoto et al., 2015) and 6 per ventral nerve cord hemineuromere (Peco et al., 2016) throughout larval development. They appear to endoreplicate and increase in size, then die during metamorphosis (Omoto et al., 2015; Kato et al., 2020).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-10-17T10:46:27Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00047840</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic/larval astrocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval astrocyte-like neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval astrocytic glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval dendritic neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval reticular neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>embryonic/larval reticular neuropil-associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pALG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>primary astrocyte-like glia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
