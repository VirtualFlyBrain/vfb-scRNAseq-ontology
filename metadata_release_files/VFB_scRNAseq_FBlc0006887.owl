    <!-- http://purl.obolibrary.org/obo/FBbt_00003127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005379"/>
