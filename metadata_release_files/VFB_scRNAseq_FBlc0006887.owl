    <!-- http://purl.obolibrary.org/obo/FBbt_00100525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00025991"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058224"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003921"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100609"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). It develops from neuroblast DL1 (CP2) (Viktorin et al., 2013; Ren et al., 2018; Plazaola-Sasieta et al., 2019). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-05-23T01:49:16Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100525</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult XG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult optic chiasm glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>giant glial cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00100525</oboInOwl:id>
        <rdfs:comment>Kremer et al. (2017) and Ren et al. (2018) expression analysis suggests that these are types of ensheathing glia, with inner tract glia being synaptic neuropil ensheathing and outer tract glia being tract neuropil ensheathing.</rdfs:comment>
        <rdfs:label>adult optic chiasma glial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100525"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). It develops from neuroblast DL1 (CP2) (Viktorin et al., 2013; Ren et al., 2018; Plazaola-Sasieta et al., 2019). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0096428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0210316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0221770</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0239137</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0243725</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100525"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>adult XG</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0234767</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/FBbt_00100532 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00005146"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0000137"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0004595"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0010109"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Neuroblast that divides asymmetrically to regenerate itself and produce a smaller ganglion mother cell that generates two daughter neurons. Many of these neuroblasts switch to type 0 division at some point during their development, to produce daughters that develop into neurons with no further division (Baumgardt et al., 2014).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-06-06T02:39:05Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100532</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>type 0 neuroblast</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100532</oboInOwl:id>
        <rdfs:comment>Bayraktar et al. (2010) show that type I neuroblasts can be distinguished from type II neuroblasts as being Deadpan-, Prospero- and Asense-positive.</rdfs:comment>
        <rdfs:label>type I neuroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100532"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Neuroblast that divides asymmetrically to regenerate itself and produce a smaller ganglion mother cell that generates two daughter neurons. Many of these neuroblasts switch to type 0 division at some point during their development, to produce daughters that develop into neurons with no further division (Baumgardt et al., 2014).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0207387</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0225698</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
