        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-15T14:20:49Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00049604</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic/larval brain cortex glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval brain CBG</oboInOwl:hasExactSynonym>
