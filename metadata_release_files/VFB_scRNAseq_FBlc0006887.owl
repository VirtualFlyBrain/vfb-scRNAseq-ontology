    <!-- http://purl.obolibrary.org/obo/FBbt_00058198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00058198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0003975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002292"/>
                <owl:someValuesFrom rdf:resource="http://flybase.org/reports/FBgn0004606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An adepithelial cell of the wing disc that gives rise to an indirect flight muscle cell in the adult. These cells are located around the wing hinge primordium in the wing disc. They are distinguished from other flight muscle precursor cells by their expression of vestigial and zfh1 (Gunage et al., 2014; Zappia et al., 2020).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-6095-8718"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-04T08:38:05Z</dc:date>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00058198</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>indirect flight muscle precursor cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00058198"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An adepithelial cell of the wing disc that gives rise to an indirect flight muscle cell in the adult. These cells are located around the wing hinge primordium in the wing disc. They are distinguished from other flight muscle precursor cells by their expression of vestigial and zfh1 (Gunage et al., 2014; Zappia et al., 2020).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0226374</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247435</oboInOwl:hasDbXref>
    </owl:Axiom>
    


