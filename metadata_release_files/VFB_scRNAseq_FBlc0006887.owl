    <!-- http://purl.obolibrary.org/obo/FBbt_00111752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00111752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003870"/>
