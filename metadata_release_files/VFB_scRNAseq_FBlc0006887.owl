        <oboInOwl:hasExactSynonym>adult alpha&apos;/beta&apos; KC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult alpha&apos;/beta&apos; neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult mushroom body alpha&apos;/beta&apos; neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult mushroom body alpha-prime/beta-prime Kenyon cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult mushroom body alpha-prime/beta-prime neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00049834</oboInOwl:id>
        <rdfs:label>adult alpha&apos;/beta&apos; Kenyon cell</rdfs:label>
    </owl:Class>
