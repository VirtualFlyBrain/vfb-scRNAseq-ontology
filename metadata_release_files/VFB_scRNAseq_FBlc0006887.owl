            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Neuropil mass below the esophagus in the adult brain. It encompasses the gnathal ganglion, the prow and the saddle.</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0001-5948-3092"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-10-08T17:53:57Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00110639</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>SEZ</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>SEG</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>SOG</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>adult subesophageal ganglion</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>adult suboesophageal ganglion</oboInOwl:hasNarrowSynonym>
