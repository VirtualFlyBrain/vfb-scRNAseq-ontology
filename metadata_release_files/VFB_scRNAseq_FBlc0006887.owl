            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A posterior part of the alimentary canal derived from the ectoderm. It extends anteriorly from close to the point of attachment of the Malpighian tubules to the anus. It is lined on its luminal side by an impermeable cuticle (Skaer, 1993).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0001046</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
