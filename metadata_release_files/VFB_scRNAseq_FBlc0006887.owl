        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000028"/>
        <owl:annotatedTarget>R2</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FlyBase:FBrf0247762</oboInOwl:hasDbXref>
