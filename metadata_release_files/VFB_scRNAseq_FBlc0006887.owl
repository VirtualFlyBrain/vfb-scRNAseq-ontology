    <!-- http://purl.obolibrary.org/obo/NCBITaxon_7227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCBITaxon_7227">
        <rdfs:subClassOf rdf:resource="http://www.bioassayontology.org/bao#BAO_0000511"/>
        <obo:IAO_0000111>Drosophila melanogaster</obo:IAO_0000111>
        <obo:IAO_0000118>Sophophora melanogaster</obo:IAO_0000118>
        <obo:IAO_0000118>fruit fly</obo:IAO_0000118>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/ncbitaxon.owl"/>
        <rdfs:label>Drosophila melanogaster</rdfs:label>
