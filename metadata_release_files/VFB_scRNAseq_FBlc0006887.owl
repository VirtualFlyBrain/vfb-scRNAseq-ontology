    <!-- http://purl.obolibrary.org/obo/FBbt_00051405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00051405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00040007"/>
