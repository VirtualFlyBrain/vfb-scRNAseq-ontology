        <obo:IAO_0000115>Spine shaped gustatory bristle, between 12-45 micrometres long, found on the prothoracic (1st) leg of the adult. There are approximately 37 of these bristles per female prothoracic leg, and 50 per male prothoracic leg (Stocker, 1994).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VFB:FBbt_00004253</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>1st leg gustatory bristle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>1st leg taste bristle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prothoracic leg gustatory bristle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00004253</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#cur"/>
        <rdfs:label>prothoracic leg taste bristle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
