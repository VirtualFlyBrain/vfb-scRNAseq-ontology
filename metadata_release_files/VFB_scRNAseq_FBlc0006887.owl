                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00004911"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A squamous monolayer epithelium that lines the oviduct. Its cells are joined along their lateral membranes by extensive septate junctions, but lack apical zonal adherens junctions (Kapelnikov et al., 2008).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-6095-8718"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-10-01T10:04:23Z</dc:date>
