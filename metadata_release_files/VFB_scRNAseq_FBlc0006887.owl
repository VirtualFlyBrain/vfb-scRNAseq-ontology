                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBdv_00005281"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Oogenesis stage during which only 5-6 nurse cell nuclei remain at the anterior of the oocyte. The oocyte nucleus is in late prometaphase:the bivalents arrange themselves in on the equatorial plane of the spindle; homologous centromeres are pulled towards the poles.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>FlyBase_development_CV</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBdv:00005282</oboInOwl:id>
