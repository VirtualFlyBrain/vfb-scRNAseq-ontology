    <!-- http://purl.obolibrary.org/obo/FBbt_00100001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00100001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FBbt_00001964"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003980"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002134"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002134"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00100015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Bundle formed from the fasciculated axons of the Johnston&apos;s organ neurons (JONs) within the antennal nerve (AN). The JONs form two bundles (dorsolateral and medioventral) within the antennal nerve by the point it reaches the base of antennal segment 1 (a1/scape). Shortly before entering the brain, these two bundles combine and spread over a large area of the AN cross-section. Upon entering the brain, the JONs predominantly occupy the ventral part of the AN. At the ventrolateral side of the antennal lobe, the bundle bifurcates. One side of the bifurcation gives rise to the main trunk of the antennal mechanosensory and motor center (AMMC). The other side defasciculates and innervates zone A of the AMMC.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-11-02T05:06:31Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100001</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>JON nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Johnston organ nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Johnston organ neuron nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Johnston&apos;s organ nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Johnston&apos;s organ neuron nerve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>FBbt:00100001</oboInOwl:id>
        <rdfs:label>Johnston organ bundle of antennal nerve</rdfs:label>
    </owl:Class>
