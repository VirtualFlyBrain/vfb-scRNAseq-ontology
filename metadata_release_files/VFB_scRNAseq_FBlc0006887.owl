                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002132"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00007386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
