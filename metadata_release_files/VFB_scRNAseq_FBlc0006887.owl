        <obo:IAO_0000115>Glial cell of the adult central nervous system that elaborates along the outer surface of its associated neuropil. Glia of this class may also surround neuropil bundles such as commissures or tracts. There are over 1000 of these in the adult central nervous system, some of which are descendants of larval ensheathing glia (Pogodalla et al., 2021).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2011-04-26T04:17:41Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00100504</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>adult EG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult ensheathing neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult fibrous lamellar neuropil associated glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>adult neuropil ensheathing glial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>sEG</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>secondary ensheathing glia</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00100504</oboInOwl:id>
        <rdfs:label>adult ensheathing glial cell</rdfs:label>
    </owl:Class>
