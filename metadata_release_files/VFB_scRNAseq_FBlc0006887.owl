    <!-- http://purl.obolibrary.org/obo/FBbt_00003209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FBbt_00003209">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/FBbt_00005066"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00003004"/>
                    </owl:Restriction>
                </owl:intersectionOf>
