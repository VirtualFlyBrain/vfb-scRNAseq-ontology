                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FBbt_00000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A neuroblast located in one of the three gnathal segments. These are all homologues of neuroblasts in the thoracic segments (Urbach et al., 2016). The development of neuroblasts in the mandibular segment is significantly delayed compared to more posterior segments (Urbach et al., 2016) and their primary lineages are smaller (Rickert et al., 2018).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-1373-1705"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2021-06-11T08:03:23Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00051363</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>neuroblast of gnathal ganglion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuroblast of gnathal neuromere</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>neuroblast of subesophageal ganglion</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00051363</oboInOwl:id>
        <rdfs:label>gnathal neuroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/FBbt_00051363"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neuroblast located in one of the three gnathal segments. These are all homologues of neuroblasts in the thoracic segments (Urbach et al., 2016). The development of neuroblasts in the mandibular segment is significantly delayed compared to more posterior segments (Urbach et al., 2016) and their primary lineages are smaller (Rickert et al., 2018).</owl:annotatedTarget>
