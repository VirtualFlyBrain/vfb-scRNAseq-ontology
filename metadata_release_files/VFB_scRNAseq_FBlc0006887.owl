        <obo:IAO_0000115>Tract of the larva that connects the antennal lobe to other neuropils in the protocerebrum, including mushroom body and lateral horn (Nassif et al., 2003; Hartenstein et al., 2015). There are three of these, the medial, mediolateral and lateral antennal lobe tracts (Das et al., 2013). They are larval counterparts to the adult antennal lobe tracts (Nassif et al., 2003).</obo:IAO_0000115>
        <dc:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2008-06-13T11:43:51Z</dc:date>
        <oboInOwl:hasDbXref>VFB:FBbt_00007148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>larvalbrain_axon_tract:3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>larvalbrain_axon_tract:4</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic/larval antenno-cerebral tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval ACT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>larval antenno-cerebral tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>fly_anatomy.ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>FBbt:00007148</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/fbbt#larval_OF"/>
        <rdfs:label>embryonic/larval antennal lobe tract</rdfs:label>
    </owl:Class>
