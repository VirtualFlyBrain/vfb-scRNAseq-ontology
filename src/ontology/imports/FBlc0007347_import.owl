# Class: <http://purl.obolibrary.org/obo/FBbt_00110074> (transmedullary neuron Tm5c)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00110074> "Tm5c")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206213") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0230403") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110074> "Transmedullary Tm5 neuron that spans around eight medulla columns with lateral branches expanding out into the M1, M3 and M6 layers from a single vertical dendrite (Kind et al., 2021). It preferentially receives input from R8 (rather than R7) photoreceptor cells, and in most, but not all, cases these cells are selective for yellow (rather than pale) ommatidia (Kind et al., 2021). Its R8 input is mainly in layer M3 and it also receives input from the distal medullary amacrine neuron Dm8 in layer M6 (Karuppudurai et al., 2014). Its axon terminates near the boundary between lobula layers 5 and 6, with some cells having a branch in layer 4 (Kind et al., 2021). It provides input to the lobula intrinsic neuron Li4 via many synapses (Lin et al., 2016). It is a glutamatergic neuron (Gao et al., 2008; Karuppudurai et al., 2014).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00110074> <https://orcid.org/0000-0001-5948-3092>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00110074> "2011-12-14T03:31:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00110074> "VFB:FBbt_00110074")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110074> "Tm5c")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110074> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110074> "FBbt:00110074")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00110074> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110074> "The neurotransmitter was assessed in cells labelled with a glutamate GAL4 driver P{GawB}vGlut[OK371] (FBti0076967) (Gao et al., 2008), RT-PCR and by immunohistochemistry (Karuppudurai et al., 2014). Connectivity inferred from GRASP experiments (Karuppudurai et al., 2014; Lin et al., 2016), from EM reconstructions (Kind et al., 2021) or from double-labeling EM (Lin et al., 2016).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00110074> "transmedullary neuron Tm5c")
