# Class: <http://purl.obolibrary.org/obo/FBdv_00007021> (third instar - cleared gut stage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076598") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00007021> "The substage of the wandering third instar larval stage when the larva has cleared its gut contents.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00007021> "FlyBase_development_CV")
