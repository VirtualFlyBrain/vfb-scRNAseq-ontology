AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00004877> "cyst cell of ovary")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004877> <http://purl.obolibrary.org/obo/FBbt_00057012>)
