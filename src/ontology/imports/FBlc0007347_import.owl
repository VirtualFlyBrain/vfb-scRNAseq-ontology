AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005318> "embryonic stage 6")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005318> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005318> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00005317>))
