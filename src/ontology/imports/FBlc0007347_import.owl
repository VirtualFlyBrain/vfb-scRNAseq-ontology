# Class: <http://purl.obolibrary.org/obo/FBdv_00005334> (embryonic stage 16)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005334> "Stage 16 begins when the intersegmental grooves can be distinguished at mid-dorsal level, and ends when the dorsal ridge (frontal sac) has overgrown the tip of the clypeolabrum, which is thereby enclosed in the atrium. During this stage the ventral cord retracts to about 60% egg length. Duration at 25 degrees C: approximately 180 minutes (780-960 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005334> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005334> "FBdv:00005334")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005334> "Temporal ordering number - 380.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005334> "embryonic stage 16")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005334> <http://purl.obolibrary.org/obo/FBdv_00005259>)
