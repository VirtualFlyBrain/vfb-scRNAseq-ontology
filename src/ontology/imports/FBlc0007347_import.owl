SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005337> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005333>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005337> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005335>))
