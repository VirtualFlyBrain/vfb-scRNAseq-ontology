SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002134> <http://purl.obolibrary.org/obo/FBbt_00100005>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002134> <http://purl.obolibrary.org/obo/FBbt_00100015>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00100005> (main trunk of antennal mechanosensory and motor center)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100005> "The main trunk (MT) of antennal mechanosensory and motor center (AMMC) is one of two bundles formed by the initial bifurcation of the Johnston's organ nerve projection, ventro-laterally to the antennal lobe. The second, more lateral bundle forms the anterior portion of AMMC zone A. The MT progresses posteriorly and exhibits a second bifurcation that gives rise to the bundle forming AMMC zone B. A final posterior MT bifurcation gives rise to the AMMC lateral core and EA bundle. The MT is devoid of presynaptic sites.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100005> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100005> "2009-12-04T02:17:06Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100005> "VFB:FBbt_00100005")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "JON-MT")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk of AMMC")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100005> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "MT")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk of JON bundle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100005> "FBbt:00100005")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100005> "That the MT lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization. It is this lack of presynaptic sites which is used to distinguish the MT from the branches of the anterior portion of Zone A and zone B which are syntaxin- and synaptobrevin-positive (Kamikouchi et al., 2006).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100005> "main trunk of antennal mechanosensory and motor center")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100005> <http://purl.obolibrary.org/obo/FBbt_00005099>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00003982>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002134> <http://purl.obolibrary.org/obo/FBbt_00100016>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002150> <http://purl.obolibrary.org/obo/FBbt_00100006>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100005> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002150> <http://purl.obolibrary.org/obo/FBbt_00100007>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00100006> (EA bundle of antennal mechanosensory and motor center)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100006> "Bundle, devoid of presynaptic sites, formed from one branch of the final, most posterior bifurcation of the antennal mechanosensory and motor center (AMMC) main trunk (MT). The other side of the bifurcation gives rise to the lateral core of the AMMC (LC). It is directly connected to zone E of the AMMC and consists of the projections of zone E Johnston's organ neurons.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100006> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100006> "2009-12-04T03:18:13Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100006> "VFB:FBbt_00100006")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "EA")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "EA bundle of AMMC")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "JON bundle EA")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "JON-EA")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "Johnston organ neuron bundle EA")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "antennal mechanosensory and motor center subarea EA")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "anterior region of bundle E")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "anterior region of zone E")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100006> "primary auditory center subarea EA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100006> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100006> "FBbt:00100006")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100006> "DISAMBIGUATION: Kamikouchi et al., 2006, refer to this as part of zone E, however we use AMMC zone E to refer only to the synapse rich region anterior to the EA. Evidence that EA bundle of AMMC lacks presynaptic sites is based on negative anti-syntaxin immunolabelling and synaptobrevin::GFP localization (Kamikouchi et al., 2006).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100006> "EA bundle of antennal mechanosensory and motor center")
