# Class: <http://purl.obolibrary.org/obo/FBbt_00001951> (larval inner optic anlage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0052913") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193624") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001951> "A ribbon-like layer of neuroepithelial cells (and later of proliferating neuroblasts) in the larval optic lobe that gives rise to the adult inner medulla, lobula and lobula plate neurons. In early larval stages it is composed of neuroepithelial cells that divide symmetrically. In the early second instar it becomes U shaped, with the opening of the U pointing in a dorso-caudal direction. It becomes distinguished from the outer optic anlage during the second half of the first instar period (Meinertzhagen and Hanson, 1993). In the third instar, neuroepithelial cells in the medial region give rise to neuroblasts that divide asymmetrically to generate the adult optic lobe neurons.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00001951> "VFB:FBbt_00001951")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204205") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001951> "IOA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001951> "embryonic/larval inner optic anlage")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0095642") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00001951> "IPC")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0095642") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00001951> "inner proliferation center")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001951> "fly_anatomy.ontology")
