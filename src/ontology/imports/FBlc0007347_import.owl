AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007402> "FBbt:00007402")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007402> "Based on GABA expression, approximately 80% of the local interneurons of the adult antennal lobe are GABAergic (Wilson and Laurent, 2005). Tanaka et al (2012) distinguishes two different types: LN1 and LN2L. LN1 neurons arborize in most of the glomeruli, whereas LN2L neurons are much more diverse.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00007402> "GABAergic local interneuron of the adult antennal lobe")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00007402> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00052874> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/FBbt_00003004>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002215> <http://purl.obolibrary.org/obo/GO_0061534>)))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007402> <http://purl.obolibrary.org/obo/FBbt_00007390>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007402> <http://purl.obolibrary.org/obo/FBbt_00058207>)

