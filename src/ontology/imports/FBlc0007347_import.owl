AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005324> "embryonic stage 10")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005324> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005324> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00014201>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005324> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005323>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005325> (embryonic stage 11)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005325> "Stage 11 begins with the invagination of the tracheal placodes. Para-segmental furrow form and segment boundary furrows become deep folds. Within the head, gnathal protuberances become apparent. The end of this stage is signaled by the appearance of a distinct cleft at the posterior pole of the embryo, which becomes detached from the vitelline membrane. This marks the beginning of germ-band retraction. Duration at 25 degrees C: approximately 120 minutes (320-440 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005325> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005325> "FBdv:00005325")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005325> "Temporal ordering number - 310.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005325> "embryonic stage 11")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005325> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005325> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00004450>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005325> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005324>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005325> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00014201>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005327> (embryonic stage 12)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005327> "Germ band retraction. Stage 12 begins when germ-band retraction starts and ends when this process is complete so that the prospective anal plate occupies the posterior pole. During this stage the posterior and anterior midgut primordia meet and fuse and the tracheal pits fuse to form the tracheal tree. Duration at 25 degrees C: approximately 120 minutes (440-560 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBdv_00005327> "retracting germ band stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005327> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005327> "FBdv:00005327")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005327> "Temporal ordering number - 320.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005327> "embryonic stage 12")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005327> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005327> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00004450>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005327> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005325>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005328> (embryonic stage 13)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005328> "Stage 13 begins at the completion of germ-band retraction, when the prospective anal plate occupy the posterior pole. The dorsal ridge becomes apparent externally; the clypeolabrum retracts, leaving a triangular shaped gap at the anterior pole; the labium moves to the ventral midline. This stage ends when head involution begins. Duration at 25 degrees C: Approximately 60 minutes (560-620 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBdv_00005328> "contracted germ band stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005328> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005328> "FBdv:00005328")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005328> "Temporal ordering number - 340.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005328> "embryonic stage 13")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005328> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005328> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00005331>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005328> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00004450>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005328> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005321>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005328> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005327>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005330> (embryonic stage 14)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005330> "Stage 14 begins with the initiation of head involution. Closure of the midgut around the yolk and dorsal closure continue. Dorsal closure is 80% complete by the end of this stage. This stage ends with the appearance of the second midgut constriction. Duration at 25 degrees C: approximately 60 minutes (620-680 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBdv_00005330> "head involution stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005330> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005330> "FBdv:00005330")
