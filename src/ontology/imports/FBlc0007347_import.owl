# Class: <http://purl.obolibrary.org/obo/FBbt_00000054> (cleavage stage embryo)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064803") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00000054> "Embryo that is in the cleavage stage, which encompasses the first 13 rapid divisions after fertilization, corresponding to embryonic stages 1-4, prior to cellularization (Hartenstein, 1993; Campos-Ortega and Hartenstein, 1997). The first seven divisions are synchronous (Campos-Ortega and Hartenstein, 1997). During the course of the subsequent three divisions, most of the nuclei approach the surface, to form the syncitial blastoderm (Campos-Ortega and Hartenstein, 1997). They then divide asynchronously a further three times, bringing the total number of cells to around 5000 (Campos-Ortega and Hartenstein, 1997).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00000054> "FBdv:00000054")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00000054> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00000054> "FBbt:00000054")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00000054> "cleavage stage embryo")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00000054> <http://purl.obolibrary.org/obo/FBbt_00000052>)

