# Class: <http://purl.obolibrary.org/obo/FBbt_00110893> (adult midgut region R2)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0221749") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0222542") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110893> "Region of the adult midgut located in the abdomen that is dorsally located and that falls back ventrally at the posterior part. It can be divided into 3 subregions, based on histology and gene expression. It is composed of enterocytes with a typical columnar morphology.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00110893> <https://orcid.org/0000-0001-5948-3092>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00110893> "2014-06-05T17:29:32Z"^^xsd:dateTime)
