# Class: <http://purl.obolibrary.org/obo/FBbt_00001102> (larval ventral nerve cord)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0238752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0246261") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247585") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001102> "Region of the larval central nervous system posterior to the gnathal neuromeres (Clark et al., 2018; Eschbach and Zlatic, 2020; Miroschnikow et al., 2020). It consists of three thoracic neuromeres, eight abdominal neuromeres and a terminal plexus (Clark et al., 2018).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00001102> "FBbt:00001971")
