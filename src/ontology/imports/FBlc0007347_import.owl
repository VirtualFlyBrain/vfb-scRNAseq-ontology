# Class: <http://purl.obolibrary.org/obo/FBbt_00110214> (larval A1-7-innervating SN motor neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064793") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0099344") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0112030") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0167986") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110214> "Motor neuron that innervates the muscles of larval abdominal segments A1-7 and which fasciculates with the segmental nerve. Its soma is located in the same segment as the muscle it innervates. The dendritic domain of the motor neuron is located posteriorly to the dendritic domain of the ISN motor neurons.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00110214> <https://orcid.org/0000-0001-5948-3092>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00110214> "2013-01-15T04:36:29Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00110214> "VFB:FBbt_00110214")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110214> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00110214> "SN motor neuron of A1-7")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0099344") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00110214> "motor neuron of external muscle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110214> "FBbt:00110214")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110214> "There is little or no published literature specifically on innervation in A1 and so where equivalent muscles are present between A1 and A2-7 (Landgraf et al., 1997; Schmid et al., 1999), we infer A1 motor neuron innervation patterns from those of A2-7. Almost all motor neurons that fasciculate with the segmental nerve have their soma located in the same segment in which the muscles they project to are located. There are two exceptions: DA2 motorneuron and VUM motor neuron (Landgraf et al., 1997).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00110214> "larval A1-7-innervating SN motor neuron")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00110214> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00005123> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002101> <http://purl.obolibrary.org/obo/FBbt_00002197>)))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00110214> <http://purl.obolibrary.org/obo/FBbt_00002451>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00110214> <http://purl.obolibrary.org/obo/FBbt_00007675>)
