# Class: <http://purl.obolibrary.org/obo/FBbt_00003682> (bulb)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0212704") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0221742") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00003682") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003682> "A bilaterally paired synaptic neuropil domain located lateral to the ellipsoid body and anterior lateral to the fan-shaped body. It contains 80 microglomeruli characterized by their granular texture. It is formed primarily by the collateral arborizations of neuronal fibers that project to the ellipsoid body and by the terminals of the fibers projecting from the anterior optic tubercle and other neuropils.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193607") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FBbt_00003682> "mimpr")
