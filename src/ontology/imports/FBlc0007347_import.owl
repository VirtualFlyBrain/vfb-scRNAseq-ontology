AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005335> "embryonic stage 17")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005335> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005335> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00005333>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005335> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005334>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005336> (larval stage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBC:DOS") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005336> "The stage of the Drosophila life-cycle from hatching to the beginning of puparium formation.")
