AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00052372> "embryonic/larval ventral nerve cord reticulated neuropil associated glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00052372> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00052372> "FBbt:00052372")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00052372> "larval VNC astrocyte-like glial cell")
