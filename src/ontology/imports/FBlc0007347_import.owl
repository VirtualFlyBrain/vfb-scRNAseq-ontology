AnnotationAssertion(Annotation(<http://purl.org/dc/terms/licence> <https://creativecommons.org/licenses/by/4.0/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:10.1093/genetics/iyad064") Annotation(rdf:type owl:Axiom) <http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/FBbt_00003678> "https://cdn.ncbi.nlm.nih.gov/pmc/blobs/acda/10213501/ccb19d89b056/iyad064f6.jpg")
