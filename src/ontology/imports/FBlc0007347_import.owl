AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00004893> <http://purl.obolibrary.org/obo/fbbt#RD>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00004893> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00004893> "DISAMBIGUATION: The term ovariole is sometimes incorrectly used to refer to individual egg chambers. Please use the term 'egg chamber' for this.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00004893> "ovariole")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004893> <http://purl.obolibrary.org/obo/FBbt_00048491>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004893> <http://purl.obolibrary.org/obo/FBbt_00100313>)
