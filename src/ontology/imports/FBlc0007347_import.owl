SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003143> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00001840>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00003144> (adult posterior hindgut)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007735") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003144> "Posterior-most region of the adult hindgut. It consists of a broadly expanded rectal sac (rectal ampulla) that tapers posteriorly to the narrow rectum proper, terminating at the anus. Protruding from the walls into the lumen of the rectal sac are two pairs of conical rectal papillae.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007735") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00003144> "adult rectum")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007735") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00003144> "posterior intestine")
