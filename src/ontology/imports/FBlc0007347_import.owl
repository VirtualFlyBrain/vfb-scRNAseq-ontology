# Class: <http://purl.obolibrary.org/obo/FBbt_00002125> (larval mesothoracic segmental nerve)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00002125> "Larval segmental nerve of the mesothoracic segment. Similar to the A1-A7 nerves, it has two roots, anterior and posterior, both formed from neurons of the same segment as the nerve (Campos-Ortega and Hartenstein, 1997). Proximally it shares a glial sheath with the intersegmental nerve (Campos-Ortega and Hartenstein, 1997). It receives sensory fibers from the ventral monoscolopidial chordotonal organ, Keilin organ and vc1 sensillum (Campos-Ortega and Hartenstein, 1997). It gives off a thick branch to the ventral lateral muscle, while its main branch continues to the lateral transverse musculature, the ventral Kolbchen and the vc2 sensillum (Campos-Ortega and Hartenstein, 1997). It additionally receives sensory fibers from the prothoracic lch3 chordotonal organ (Campos-Ortega and Hartenstein, 1997).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/FBbt_00002125> "SN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00002125> "VFB:FBbt_00002125")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00002125> "mesothoracic posterior fascicle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00002125> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00002125> "FBbt:00002125")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00002125> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00002125> "larval mesothoracic segmental nerve")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00002125> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00002037> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00000018>)))
