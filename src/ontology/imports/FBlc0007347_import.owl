# Class: <http://purl.obolibrary.org/obo/FBbt_00100000> (Johnston organ neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00100000> "JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0083230") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0236066") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100000> "Scolopidial (mechanosensory) neuron of Johnston's organ (JO). Its axon innervates the ipsilateral antennal mechanosensory and motor center (AMMC). A small number of fibers also innervate the contralateral AMMC via the commissure of JON. Subset of JO neurons extend into the ventral region of the ventrolateral protocerebrum and posterior part of the subesophageal ganglion. They are cholinergic and a subset are glutamatergic (Ishikawa et al., 2017).")
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100000> "2009-11-02T05:06:31Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100000> "VFB:FBbt_00100000")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100000> "JON")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194812") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100000> "Johnston's organ neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100000> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100000> "FBbt:00100000")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100000> "Believed to be cholinergic on the basis of expression of a (ChAT)-lacZ fusion gene (Kitamoto et al., 1995).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100000> "Johnston organ neuron")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00100000> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00005106> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013007> <http://purl.obolibrary.org/obo/FBbt_00004178>)))
