# Class: <http://purl.obolibrary.org/obo/FBbt_00001726> (embryonic/larval corpus cardiacum)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0053727") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0178933") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0179777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204742") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0253296") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001726> "Region of the larval ring gland closest to the brain that forms a U-shape around the floor of the aorta (Dai and Gilbert, 1991; de Velasco et al., 2004). It is connected to the brain by the nervi corporis cardiaci, which carry axons of secretory neurons that release neuropeptides in this location (Dirksen et al., 2008). It produces Adipokinetic hormone (Lee and Park, 2004) and sequesters insulin-like peptides released by insulin secreting cells of the pars intercerebralis (Ghosh et al., 2022). These two hormones are packaged into the same secretory vesicles (Ghosh et al., 2022).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001726> "larval corpus cardiacum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001726> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00001726> "corpora cardiacum")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001726> "FBbt:00001726")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001726> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00001726> "embryonic/larval corpus cardiacum")
