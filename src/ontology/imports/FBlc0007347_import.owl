# Class: <http://purl.obolibrary.org/obo/FBbt_00003788> (transmedullary neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00003788> "Tm")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204652") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003788> "An intrinsic columnar neuron of the optic lobe whose cell body lies in the distal cortex of the medulla and that projects through the medulla and optic chiasm into the lobula. All neurons arborize in the lobula and most, but not all, in the medulla (Fischbach and Dittrich, 1989).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00003788> "VFB:FBbt_00003788")
