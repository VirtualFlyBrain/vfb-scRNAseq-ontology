AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005330> "embryonic stage 14")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005330> <http://purl.obolibrary.org/obo/FBdv_00005259>)
