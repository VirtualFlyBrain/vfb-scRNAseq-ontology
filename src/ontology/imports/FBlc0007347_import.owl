SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003727> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00052324>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003727> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013002> <http://purl.obolibrary.org/obo/FBbt_00003708>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003727> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013002> <http://purl.obolibrary.org/obo/FBbt_00003750>))
