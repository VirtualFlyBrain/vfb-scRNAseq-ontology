# Class: <http://purl.obolibrary.org/obo/FBbt_00004912> (lateral oviduct)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007735") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207006") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0253444") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00004912> "Epithelial tube that connects the ovary to the common oviduct (McQueen et al., 2022). It is lined with a chitinous intima, and surrounded by muscle (McQueen et al., 2022). There are two of these per organism (one per ovary) (McQueen et al., 2022). They usually have a loop near the base of the ovary in unmated females; the loop relaxes after mating to allow egg transit (Kapelnikov et al., 2008; McQueen et al., 2022).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00004912> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00004912> "FBbt:00004912")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00004912> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00004912> "lateral oviduct")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004912> <http://purl.obolibrary.org/obo/FBbt_00007474>)
