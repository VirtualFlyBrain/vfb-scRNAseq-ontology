# Class: <http://purl.obolibrary.org/obo/FBbt_00006007> (outer photoreceptor cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0054529") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0216925") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00006007> "An eye photoreceptor cell whose rhabdomere is part of the outer trapezoid of rhabdomeres of each ommatidium. There are six of these per ommatidium. Each has a single axon that projects along a single lamina optic cartridge within which it makes extensive synaptic connections before terminating in the proximal lamina. It is strongly presynaptic to lamina monopolar neurons L1 and L2 and the lamina intrinsic (amacrine) neuron (Rivera-Alba et al., 2011).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00006007> "FlyBrain_NDB:10111")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00006007> "VFB:FBbt_00006007")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00006007> "photoreceptor cell R1-6")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00006007> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00006007> "FBbt:00006007")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00006007> <http://purl.obolibrary.org/obo/fbbt#cur>)
