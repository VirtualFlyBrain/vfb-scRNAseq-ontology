# Class: <http://purl.obolibrary.org/obo/FBbt_02000003> (photoreceptor cell R8 of yellow ommatidium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0232800") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_02000003> "yR8")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0180690") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205531") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0230092") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_02000003> "Photoreceptor cell R8 that is part of a yellow ommatidium and expresses Rhodopsin 6 (Wernet and Desplan, 2004). It outputs to TM5c, mostly in layer M3 where it terminates, but also in M1-2 (Karuppudurai et al., 2014) and to Tm20, Mi1, Mi4 and some lamina monopolar neurons of the same column (Takemura et al., 2015). It also outputs onto photoreceptor cell R7 of the same column (Takemura et al., 2008; Takemura et al., 2015), mostly in M3 (Takemura et al., 2008).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_02000003> "VFB:FBbt_02000003")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0232800") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_02000003> "yR8")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_02000003> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_02000003> "FBbt:02000003")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_02000003> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_02000003> "Connectivity with TM5c inferred from GRASP experiments (Karuppudurai et al., 2014). Connectivity with R7, Mi1, Mi4, Tm20 and lamina monopolar neurons based on EM data (Takemura et al., 2008; Takemura et al., 2015). Assertion in Gao et al. (2008) - FBrf0206213 that (non-DRA) R8 is synapsed to Tm9 is not supported by EM data in Takemura et al. (2015).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_02000003> "photoreceptor cell R8 of yellow ommatidium")
