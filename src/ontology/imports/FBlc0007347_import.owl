AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005351> "Temporal ordering number - 590.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005351> "pupal stage P5(i)")
