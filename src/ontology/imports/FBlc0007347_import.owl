# Class: <http://purl.obolibrary.org/obo/FBbt_00003152> (adult dorsal vessel)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0108687") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003152> "Dorsal vessel of the adult. It extends from the sixth abdominal segment to the dorsal anterior region of the brain (Curtis et al., 1999). The anterior portion, which is devoid of ostia, is the aorta, whilst the posterior (caudal) region, which has ostia, forms the heart proper.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00003152> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00003152> "FBbt:00003152")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00003152> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00003152> "adult dorsal vessel")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00003152> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00058291> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/FBbt_00003004>)))
