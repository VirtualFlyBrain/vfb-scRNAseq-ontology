# Class: <http://purl.obolibrary.org/obo/FBbt_00110073> (transmedullary neuron Tm5b)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00110073> "Tm5b")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206213") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0230403") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110073> "Transmedullary Tm5 neuron that extends two or three vertical main dendritic branches in the medulla, spanning around five columns, from which branches spread laterally into layers M3, M6 and M8 (Kind et al., 2021). It receives most of its inner (R7/R8) photoreceptor input from the R7 photoreceptors of pale ommatidia (Kind et al., 2021). Its axon innervates lobula layer 5 (Kind et al., 2021). It provides input to the lobula intrinsic neuron Li4 via many synapses (Lin et al., 2016). It is a cholinergic neuron (Karuppudurai et al., 2014).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00110073> <https://orcid.org/0000-0001-5948-3092>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00110073> "2011-12-14T03:31:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00110073> "VFB:FBbt_00110073")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110073> "Tm5b")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110073> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110073> "FBbt:00110073")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00110073> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110073> "The neurotransmitter was assessed by immunohistochemistry (Karuppudurai et al., 2014). Connectivity in the lobula was assessed by GRASP and double-labeling EM (Lin et al., 2016). Photoreceptor input determined from EM (Kind et al., 2021).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00110073> "transmedullary neuron Tm5b")
