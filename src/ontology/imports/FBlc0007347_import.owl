# Class: <http://purl.obolibrary.org/obo/FBdv_00007019> (third instar - uncleared gut stage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076598") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00007019> "The substage of the wandering third instar larval stage, prior to the beginning of clearance of the gut.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00007019> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00007019> "FBdv:00007019")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00007019> "Temporal ordering number - 462. This is commonly assayed by adding 0.5% bromophenol blue to the food and looking for wandering third instar larvae with the same color guts (dark blue) as feeding larvae (Andres and Thummel, 1994). Larvae at this stage are in chromosomal puff stage 1 (Andres and Thummel, 1994).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00007019> "third instar - uncleared gut stage")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00007019> <http://purl.obolibrary.org/obo/FBdv_00005259>)
