AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001938> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001938> "Can be distinguished from other optic lobe neuroblasts based on expression of dpn and ase (Konstantinides et al., 2022).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00001938> "medulla forming neuroblast")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00001938> <http://purl.obolibrary.org/obo/FBbt_00052344>)
