AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00040041> "The vest corresponds to part of the inferior region of the vmpr of Otsuna and Ito (2006) and the part of the precommissural ventromedial cerebrum (Ito et al., 2014).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00040041> "vest")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00040041> <http://purl.obolibrary.org/obo/FBbt_00040007>)
