SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00110638> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00110636>))

