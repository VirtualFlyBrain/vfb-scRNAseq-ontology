# Class: <http://purl.obolibrary.org/obo/FBdv_00007020> (third instar - partially cleared gut stage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0076598") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00007020> "The substage of the wandering third instar larval stage when the larva has partially cleared its gut contents.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00007020> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00007020> "FBdv:00007020")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00007020> "Temporal ordering number - 465. This is commonly assayed by adding 0.5% bromophenol blue to the food and looking for wandering third instar larvae with lighter colored guts (light blue) than feeding larvae (Andres and Thummel, 1994). Larvae at this stage are mainly in chromosomal puff stages 2-7 (Andres and Thummel, 1994).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00007020> "third instar - partially cleared gut stage")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00007020> <http://purl.obolibrary.org/obo/FBdv_00005259>)
