# Class: <http://purl.obolibrary.org/obo/FBbt_00005721> (epithelial glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134808") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0214261") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005721> "Cuboidal glial cell found in the visual system of larvae and adults, located more distal than the row of marginal glial cells. These glial cells contact marginal glia at their base (proximal) and satellite glia at their apex (distal), and constitute the only class of cells with nuclei in the neuropil proper, in the distal lamina.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00005721> "VFB:FBbt_00005721")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005721> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005721> "FBbt:00005721")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005721> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005721> "epithelial glial cell")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005721> <http://purl.obolibrary.org/obo/FBbt_00001303>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005721> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00005095>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00005722> (adult lamina marginal glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0055906") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134808") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0205531") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0218414") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005722> "Specialized ensheathing glial cell of the lamina (Edwards et al., 2012; Kremer et al., 2017). These cells form a contiguous layer at the proximal surface of the lamina and associate with multiple lamina columns (Edwards et al., 2012; Kremer et al., 2017). Their processes extend into the lamina, ensheathing proximal parts of the cartridges (Kremer et al., 2017). They also extend protrusions proximally into the outer chiasm (Kremer et al., 2017). It is between the marginal glial cells and epithelial glial cells that the R1-R6 growth cones terminate (Poeck et al., 2001; Winberg et al., 1992). There are around 100 of these cells per lamina (Kremer et al., 2017).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00005722> "FBbt:00100515")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00005722> "VFB:FBbt_00005722")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00005722> "L-EG")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00005722> "adult lamina ensheathing glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005722> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0134808") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00005722> "proximal glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005722> "FBbt:00005722")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005722> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005722> "adult lamina marginal glial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00005722> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00047836> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00003708>)))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005722> <http://purl.obolibrary.org/obo/FBbt_00058224>)
