# Class: <http://purl.obolibrary.org/obo/FBbt_00052149> (gut-innervating neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0223413") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00052149> "Neuron that innervates any part of the gut. These cells include sensory neurons, as well as efferent neurons that terminate on the visceral muscles and the underlying epithelium (Lemaitre and Miguel-Aliaga, 2013). They are chemically and neuroanatomically diverse, with efferent neurons collectively producing several neuropeptides and serotonin (Lemaitre and Miguel-Aliaga, 2013).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00052149> <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00052149> "2022-03-24T13:50:11Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00052149> "VFB:FBbt_00052149")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00052149> "enteric neuron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00052149> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00052149> "FBbt:00052149")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00052149> "Many recent papers do not count the pharyngeal and labral taste neurons as 'enteric neurons', hence only a narrow synonym.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00052149> "gut-innervating neuron")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00052149> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00005106> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/FBbt_00047143>)))
