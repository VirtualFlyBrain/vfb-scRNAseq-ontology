# Class: <http://purl.obolibrary.org/obo/FBbt_00005786> (Malpighian tubule)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0030988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0160493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0166419") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005786> "Epithelial tube with excretory and osmoregulatory roles connected, via a ureter, to the alimentary canal at the junction of the hindgut and midgut. At mid-embryogenesis, there are 6 to 10 cells encircling the lumen, whereas later on, after a phase of tubule elongation, only 2 cells encircle the lumen. There are two pairs of Malpighian tubules: one pair arises from the dorsal part of the hindgut and lies at the anterior end of the abdomen; the other pair arises from the ventral part of the hindgut and lies at the posterior end of the abdomen. Each pair shares a common ureter. The anterior pair is longer than the posterior pair.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00005786> "UBERON:0001054")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0209268") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00005786> "renal tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005786> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005786> "FBbt:00005786")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005786> <http://purl.obolibrary.org/obo/fbbt#FB_gloss>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005786> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005786> "Malpighian tubule")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005786> <http://purl.obolibrary.org/obo/FBbt_00007474>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005786> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00005056>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005786> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002150> <http://purl.obolibrary.org/obo/FBbt_00005384>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00005787> (posterior Malpighian tubule)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0075100") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0222532") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005787> "Posterior Malpighian tubule that extends from the midgut hindgut border. It is formed from the ventral part of the hindgut. There is a pair of these that are connected to a common ureter that is on the midgut/hindgut border. The posterior tubules extend towards the tail of the embryo, with each tubule positioned on opposite sides within the body cavity. At the end of embryogenesis, the distal ends switch sides by crossing over the posterior region of the hindgut. In the mature tubules, the tip cell of the posterior tubules makes contact with the a9 abdominal visceral nerve. The posterior tubule pair is shorter than the posterior one.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005787> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005787> "FBbt:00005787")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005787> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005787> "posterior Malpighian tubule")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005787> <http://purl.obolibrary.org/obo/FBbt_00005786>)

# Class: <http://purl.obolibrary.org/obo/FBbt_00005789> (Malpighian tubule segment)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0030988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0083335") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0128452") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0184042") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0202697") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0218070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0222532") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0245230") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005789> "Segment of the Malpighian tubule. Each tubule can be divided into distinct segments based on differences in appearance, cell structure and function. The initial segment is involved in calcium homeostasis and excretion, the transitional and main segment are secretory and the lower tubule and ureter are reabsorptive. Type I cells are found in all segments, but Type II cells are only found in the upper tubule (initial, transitional and main segments).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005789> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005789> "FBbt:00005789")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005789> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005789> "Malpighian tubule segment")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005789> <http://purl.obolibrary.org/obo/FBbt_00007474>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005789> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00005786>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00005790> (initial segment of Malpighian tubule)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0030988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0083335") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0128452") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0184042") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0218070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0222532") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005790> "Distal segment of the Malpighian tubule. It is involved in calcium homeostasis and excretion. The initial segment of the adult is smaller than in the larva.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0083335") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00005790> "distal segment of Malpighian tubule")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005790> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005790> "FBbt:00005790")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005790> <http://purl.obolibrary.org/obo/fbbt#cur>)
