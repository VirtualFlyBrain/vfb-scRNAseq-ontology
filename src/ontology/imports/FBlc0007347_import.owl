SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005336> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002090> <http://purl.obolibrary.org/obo/FBdv_00007001>))

# Class: <http://purl.obolibrary.org/obo/FBdv_00005337> (first instar larval stage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007733") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005337> "The first larval instar begins at hatching and ends at the first larval molt. Anterior spiracles are not yet present; posterior spiracles have two openings each. Salivary glands are very small and all cells are uniform in size. Mouth hooks typically have one tooth. Duration at 25 degrees C: approximately 25 hours (24-49 hours after egg laying; 0-25 hours after hatching).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBdv_00005337> "UBERON:8000000")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBdv_00005337> "L1")
