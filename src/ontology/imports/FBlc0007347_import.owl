# Class: <http://purl.obolibrary.org/obo/FBbt_00047884> (precursor of adult central brain neuropil glia)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0229106") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00047884> "Precursor of neuropil associated glia of the adult central brain. It arises from a type II neuroblast in the central brain during larval development. Different neuroblasts generally contribute to glia of different adult brain regions. These precursors clonally expand during metamorphosis, spread out across the neuropil surfaces and mature into adult glia.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00047884> <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00047884> "2018-10-24T14:02:49Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00047884> "VFB:FBbt_00047884")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0229106") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00047884> "sNPG precursor of central brain")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00047884> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00047884> "FBbt:00047884")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00047884> "Some of these cells migrate to the optic lobe, but optic lobe-born glia do not migrate to the central brain (Omoto et al., 2015).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00047884> "precursor of adult central brain neuropil glia")
