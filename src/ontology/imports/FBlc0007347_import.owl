AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005074> <http://purl.obolibrary.org/obo/fbbt#scrnaseq_slim>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00005074> "In contrast to vertebrates, in Drosophila embryos and larva, each muscle is a single myotube (Maqbool and Jagla, 2007).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005074> "muscle cell")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005074> <http://purl.obolibrary.org/obo/FBbt_00100318>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005074> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00005069>))
