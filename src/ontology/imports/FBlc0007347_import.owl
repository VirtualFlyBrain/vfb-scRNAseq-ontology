# Class: <http://purl.obolibrary.org/obo/FBbt_00006022> (external sensory organ precursor cell IIIb)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0111371") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0217319") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0241429") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00006022> "Precursor cell daughter of an external sensory organ precursor cell IIb. In the development of antennal olfactory sensilla, there are two classes, pNa and pNb, which each divide asymmetrically to produce up to four types of sensory neuron per sensillum (Endo et al., 2012; Chai et al., 2019). In the microchaete lineage, there is one of these cells (the other daughter of pIIb is a glial cell), which divides to produce one neuron and one apical sheath cell (Gho et al., 1999).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00006022> "pIIIb")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00006022> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00006022> "FBbt:00006022")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00006022> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00006022> "The reference paper (Gho et al., 1999) provides evidence for the existence of this intermediate stage between pIIb and the birth of the eo neuron in the wing mechanoreceptor development. There may be some question as to whether this can be generalized to all external sensory organs, but in the absence of evidence that the development of these organs is distinct I have applied this stage to all external sensory organ development. ds060308.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00006022> "external sensory organ precursor cell IIIb")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00006022> <http://purl.obolibrary.org/obo/FBbt_00005164>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00006022> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00005167>))

