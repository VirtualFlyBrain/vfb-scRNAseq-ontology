SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005073> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00058111>))

