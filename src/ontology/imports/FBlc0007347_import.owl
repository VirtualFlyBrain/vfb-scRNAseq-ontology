# Class: <http://purl.obolibrary.org/obo/FBbt_00004221> (photoreceptor cell R5)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00004221> "R5")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0216925") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00004221> "Outer photoreceptor cell of the adult eye whose rhabdomere is located at a non-right angle vertex of the shorter of the two parallel sides of the trapezoid of rhabdomeres in each ommatidium. It has a single axon that projects along a single lamina optic cartridge (Fischbach and Dittrich, 1989; Wolff and Ready, 1993).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00004221> "FBbt:00003714")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00004221> "CL:0000702")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00004221> "VFB:FBbt_00004221")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00004221> "R5")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00004221> "lamina receptor cell R5")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00004221> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00004221> "receptor cell R5")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00004221> "FBbt:00004221")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00004221> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00004221> "The name photoreceptor cell R5 is occasionally, mistakenly assumed to refer to any Rh5 expressing photoreceptor cell. This is incorrect. This term only refers to a type of adult eye photoreceptor cell. The name is based simply on the position of the cell and its rhabdomere within each ommatidium - see figure 4 in Wolff and Ready, 1993. Cell connectivity was determined by analysis of semi-automated EM reconstruction of 749 serial sections of 21 complete lamina cartridges. The number of synaptic connections for R5 (presynaptic/postsynaptic) in a single lamina cartridge with each cell type was the following: L1 (38/-), L2 (39/-), L3 (6/-), L4 (-/3), Lai (35/2), C2 (1/-), epithelial glia (10/-) and marginal glia (1/-) (Rivera-Alba et al., 2011).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00004221> "photoreceptor cell R5")
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/licence> <https://creativecommons.org/licenses/by/4.0/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:10.1007/s00359-019-01375-9") Annotation(rdf:type owl:Axiom) <http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/FBbt_00004221> "https://cdn.ncbi.nlm.nih.gov/pmc/blobs/bae0/7069908/ef7abe34662d/359_2019_1375_Fig2_HTML.jpg")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004221> <http://purl.obolibrary.org/obo/FBbt_00006007>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00004221> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00048007>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00004223> (photoreceptor cell R6)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00004223> "R6")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0216925") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00004223> "Outer photoreceptor cell of the adult eye whose rhabdomere is located at the right angle vertex of the shorter of the two parallel sides of the trapezoid of rhabdomeres in each ommatidium. It has a single axon that projects along a single lamina optic cartridge (Fischbach and Dittrich, 1989; Wolff and Ready, 1993).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/FBbt_00004223> "FBbt:00003715")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00004223> "CL:0000705")
