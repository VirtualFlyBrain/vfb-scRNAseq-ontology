AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00040016> "FBbt:00040016")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00040016> "lobula layer 5")
