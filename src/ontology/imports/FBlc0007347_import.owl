# Class: <http://purl.obolibrary.org/obo/FBbt_00005794> (specialized Malpighian tubule cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0184042") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005794> "Specialized cell of the Malpighian tubules. There are four different types: type I, type II, tip and tiny cell.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00005794> "specialised Malpighian tubule cell")
