# Class: <http://purl.obolibrary.org/obo/FBbt_00100506> (adult brain perineurial glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0210316") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100506> "Small, oblong-shaped glial cell that is part of the (outer) perineurial sheath layer on the surface of the adult brain. It is located on top of the basal glial cell layer that is composed of the subperineurial glial cells.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100506> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100506> "2011-04-27T11:05:54Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100506> "VFB:FBbt_00100506")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100506> "adult brain PNG")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100506> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100506> "FBbt:00100506")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100506> "The perineurial glial cells develop post-embryonically, in a non-GCM manner, and are thus likely to function only in the blood-brain-barrier of the adult (Edwards and Meinertzhagen, 2010).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100506> "adult brain perineurial glial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00100506> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00005144> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00003624>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00007089>)))
