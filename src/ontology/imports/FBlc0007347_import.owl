SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100525> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00100609>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00100532> (type I neuroblast)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0225698") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100532> "Neuroblast that divides asymmetrically to regenerate itself and produce a smaller ganglion mother cell that generates two daughter neurons. Many of these neuroblasts switch to type 0 division at some point during their development, to produce daughters that develop into neurons with no further division (Baumgardt et al., 2014).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100532> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100532> "2011-06-06T02:39:05Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100532> "VFB:FBbt_00100532")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0225698") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00100532> "type 0 neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100532> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100532> "FBbt:00100532")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100532> "Bayraktar et al. (2010) show that type I neuroblasts can be distinguished from type II neuroblasts as being Deadpan-, Prospero- and Asense-positive.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100532> "type I neuroblast")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100532> <http://purl.obolibrary.org/obo/FBbt_00005146>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100532> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002292> <http://flybase.org/reports/FBgn0000137>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100532> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002292> <http://flybase.org/reports/FBgn0004595>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100532> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002292> <http://flybase.org/reports/FBgn0010109>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00100533> (type II neuroblast)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204899") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0207387") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0209927") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0214289") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0214495") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0233706") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0237530") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100533> "Neuroblast that divides asymmetrically regenerate itself and produce a smaller intermediate neural progenitor (INP), which can produce multiple ganglion mother cells (Boone and Doe, 2008, Viktorin et al., 2011; Ren et al., 2016). Each type II neuroblast can produce multiple INPs, leading to the generation of multiple sublineages and typically more progeny than type I neuroblasts (Ren et al., 2016). It arises relatively late during embryonic development, delaminating from the dorsal cephalic neuroectoderm during stages 11-15 (Walsh and Doe, 2017). These cells and any existing INPs enter quiescence shortly before larval hatching (Walsh and Doe, 2017). There are eight type II neuroblasts per hemisphere, all belonging to the brain (Walsh and Doe, 2017).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100533> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100533> "2011-06-06T02:54:10Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100533> "VFB:FBbt_00100533")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100533> "TA neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100533> "transiently amplifying neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100533> "transit amplifying neuroblast")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100533> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100533> "FBbt:00100533")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100533> "Bayraktar et al. (2010) show that type II neuroblasts can be distinguished from type I neuroblasts as being Deadpan-positive, but Prospero- and Asense-negative. Walsh and Doe (2017) also use pointed as a positive marker. Arise later than NBs of embryonic NB map in Urbach and Technau (2003) - FBrf0173125 (Walsh and Doe, 2017).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100533> "type II neuroblast")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100533> <http://purl.obolibrary.org/obo/FBbt_00001333>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100533> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002292> <http://flybase.org/reports/FBgn0003118>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100533> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002292> <http://flybase.org/reports/FBgn0010109>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00100609> (neuroblast CP2)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0194268") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0221412") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0221438") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0229672") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0239137") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100609> "Type II neuroblast with a primary lineage similar to that of CP3, having a thick tract at the ventrolateral boundary of the calyx that bifurcates into dorsal and ventral branches, contributing to the oblique posterior tract and the dorsal component of the posterior-lateral fascicle, respectively (Hartenstein et al., 2015). Its secondary lineage has two clusters of somas in the posterior brain and innervates several regions of the ipsilateral brain, as well as the fan-shaped body (Ito et al., 2013). It produces adult optic lobe glia, as well as cell body glia of the lateral cell body rind region (Ren et al., 2018).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100609> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
