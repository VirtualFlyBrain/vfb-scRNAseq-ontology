# Class: <http://purl.obolibrary.org/obo/FBbt_00003708> (lamina)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0231227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00003708") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003708> "Lateral-most synaptic neuropil domain of the adult optic lobes, lying just beneath the compound eyes. It is composed of an array of repetitive cartridge-like units, each of which receives axons from specific sets of ommatidia in the compound eyes.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00003708> "VFB:FBbt_00003708")
