# Class: <http://purl.obolibrary.org/obo/FBbt_00001933> (larval outer optic anlage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0052913") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0064800") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0193624") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0225842") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00001933> "The lateral, outer layer of the larval optic lobe. It consists of neuroepithelial cells (and later of proliferating neuroblasts) that will give rise to the neurons of the adult lamina and outer medulla. By the late first instar, it is dome shaped and perforated at its center by a pore, through which axons of the optic stalk pass (Meinertzhagen and Hanson, 1993). Some of these axons form synapses in the larval optic neuropil, which is largely within this pore (Sprecher et al., 2011). It becomes distinguished from the inner optic anlage during the second half of the first instar period (Meinertzhagen and Hanson, 1993). In the third instar, neuroepithelial cells in the medial region give rise to neuroblasts that divide asymmetrically to generate the adult optic lobe neurons. This anlage is patterned by expression of Optix and Vsx1 in complementary regions (Gold and Brand, 2014).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00001933> "VFB:FBbt_00001933")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204205") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001933> "OOA")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00001933> "embryonic/larval outer optic anlage")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0095642") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00001933> "OPC")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0095642") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/FBbt_00001933> "outer proliferation center")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00001933> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00001933> "FBbt:00001933")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00001933> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00001933> "'proliferation center' synonyms usually used for later stages of development (Ngo et al., 2017 - FBrf0236058).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00001933> "larval outer optic anlage")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00001933> <http://purl.obolibrary.org/obo/FBbt_00007676>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00001933> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/FBbt_00005822>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00001933> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002203> <http://purl.obolibrary.org/obo/FBbt_00001939>))

