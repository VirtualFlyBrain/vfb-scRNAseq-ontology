AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00003234> "FBbt:00003234")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00003234> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00003234> "abdominal adult muscle precursor cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00003234> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00003232> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00000021>)))
