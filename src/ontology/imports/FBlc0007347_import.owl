AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00111738> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00111738> "FBbt:00111738")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00111738> "optic lobe neuroepithelial cell")
