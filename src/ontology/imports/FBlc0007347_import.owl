# Class: <http://purl.obolibrary.org/obo/FBbt_00110072> (transmedullary neuron Tm5a)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00110072> "Tm5a")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206213") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0230403") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00110072> "Transmedullary Tm5 neuron that is centered on a single yellow column in the medulla and arborizes in the M3, M6 and M8 layers, reaching some neighboring columns laterally (Kind et al., 2021). It selectively receives input from the R7 (and not R8) photoreceptor of its central column (Kind et al., 2021). Its axon terminates in lobula layer 5B after a characteristic reversal of direction (Kind et al., 2021). It provides input to the lobula intrinsic neuron Li4 via many synapses, and also to the lobula tangential neuron LT11 (Lin et al., 2016). It is a cholinergic neuron (Karuppudurai et al., 2014).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00110072> <https://orcid.org/0000-0001-5948-3092>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00110072> "2011-12-14T03:31:46Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00110072> "VFB:FBbt_00110072")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110072> "Tm5a")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110072> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110072> "FBbt:00110072")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00110072> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110072> "Connectivity in the medulla inferred from EM reconstructions (Gao et al., 2008; Kind et al., 2021). The neurotransmitter was assessed by immunohistochemistry (Karuppudurai et al., 2014). Connectivity in the lobula was assessed by GRASP and double-labeling EM (Lin et al., 2016).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00110072> "transmedullary neuron Tm5a")
