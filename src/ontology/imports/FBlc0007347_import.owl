# Class: <http://purl.obolibrary.org/obo/FBbt_00052371> (larval VNC ensheathing glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0082171") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0231858") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0236333") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0251788") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00052371> "Ensheathing glial cell of the larval ventral nerve cord. There are approximately four of these cells that ensheath the synaptic neuropil in each abdominal hemineuromere throughout larval development, including two that wrap the proximal parts of the nerve roots (Pogodalla et al., 2021). Three of these four synaptic neuropil-ensheathing glia derive from the longitudinal glioblast (Peco et al., 2016). There are also three or four midline glia per neuromere, which ensheath the commissural axons (Ito et al., 1995; Banerjee et al., 2017). Some of these cells also extend into the dorsal cell body rind and wrap neuronal cell bodies (Pogodalla et al., 2021).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00052371> <https://orcid.org/0000-0002-1373-1705>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00052371> "2022-10-27T10:39:12Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00052371> "VFB:FBbt_00052371")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00052371> "embryonic/larval ventral nerve cord ensheathing neuropil associated glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00052371> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00052371> "FBbt:00052371")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00052371> "larval VNC ensheathing glial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00052371> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00047836> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00001102>)))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00052371> <http://purl.obolibrary.org/obo/FBbt_00047837>)
