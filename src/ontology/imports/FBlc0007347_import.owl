SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005722> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00003747>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00005723> (adult lamina satellite glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0210316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005723> "Cell body glial cell of the lamina. Unlike in other cell body rind regions of the brain, the cell body glia of the lamina form two distinct layers and multiple neuronal cell bodies may be found in one glial pocket (Kremer et al., 2017).")
