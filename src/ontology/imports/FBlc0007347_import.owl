AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00040042> "posterior ventrolateral protocerebrum")
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/licence> <https://creativecommons.org/licenses/by/4.0/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:10.1093/genetics/iyad064") Annotation(rdf:type owl:Axiom) <http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/FBbt_00040042> "https://cdn.ncbi.nlm.nih.gov/pmc/blobs/acda/10213501/ccb19d89b056/iyad064f6.jpg")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00040042> <http://purl.obolibrary.org/obo/FBbt_00040007>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00040042> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00007058>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00040043> (anterior ventrolateral protocerebrum)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VFB_vol:00040043") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00040043> "An aglomerular, bilaterally paired synaptic neuropil domain of the adult ventrolateral protocerebrum (VLP) that protrudes from the anterior brain between the optic lobe and the antennal lobe. It is located in front of the posterior VLP and below the anterior optic tubercle and superior clamp. It receives input from neurons projecting from the optic lobe.")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00040043> <https://orcid.org/0000-0002-7073-9172>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00040043> "2009-08-13T04:16:39Z"^^xsd:dateTime)
