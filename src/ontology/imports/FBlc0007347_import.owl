# Class: <http://purl.obolibrary.org/obo/FBbt_00007089> (perineurial glial sheath)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0057603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0058936") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0226917") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007089> "The outermost cellular layer of the nervous system, probably of mesodermal origin (Hartenstein and Jan, 1992). This layer consists of glial cells, which participate in nutrient uptake and establish a first diffusion barrier (Limmer et al., 2014).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007089> "VFB:FBbt_00007089")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0206543") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007089> "apical glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007089> "perineural sheath")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007089> "perineurial sheath")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007089> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0214261") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007089> "neural lamella")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007089> "FBbt:00007089")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007089> "Evidence of mesodermal origin comes from the observation that embryos lacking mesoderm lack this cell layer and the overlying neural lamella (Edwards et al., 1993).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00007089> "perineurial glial sheath")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007089> <http://purl.obolibrary.org/obo/FBbt_00007003>)
