SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005350> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005342>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005350> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005346>))
