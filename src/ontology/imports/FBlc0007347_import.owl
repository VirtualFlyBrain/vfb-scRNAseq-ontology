AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00001104> "larval ventral nerve cord commissure")
EquivalentClasses(<http://purl.obolibrary.org/obo/FBbt_00001104> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/FBbt_00049998> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002131> <http://purl.obolibrary.org/obo/FBbt_00001727>)))
