# Class: <http://purl.obolibrary.org/obo/FBbt_00007090> (perineurium)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0057603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0191040") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0226917") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0239343") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007090> "The outer two layers of glial cells that cover the central nervous system and the nerves. The outer layer is the perineurial glial sheath (sometimes referred to as the perineurial sheath outer layer); the inner layer is the subperineurial glial sheath (sometimes referred to as the perineurial sheath inner layer).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007090> "VFB:FBbt_00007090")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007090> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0226917") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007090> "blood-brain barrier")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007090> "FBbt:00007090")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007090> "Some authors use this term only to refer to the double layer of cells covering the CNS (e.g. Hartenstein and Jan, 1992), while other authors use it more broadly to include the covering of nerves (e.g. Banerjee et al., 2006). This ontology uses the term in its broad sense. 'Blood-brain barrier' may refer to this (e.g. Limmer et al., 2014) or the subperineurial glial sheath alone (e.g. Morante et al., 2013).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00007090> "perineurium")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007090> <http://purl.obolibrary.org/obo/FBbt_00007010>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007090> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00005093>))

# Class: <http://purl.obolibrary.org/obo/FBbt_00007091> (subperineurial glial sheath)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0057603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0058936") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0226917") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0239343") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00007091> "Inner glial cell layer of the perineurium that is probably not derived from the mesoderm (Edwards et al., 1994). This layer form an ion permeability barrier, functionally similar to the endothelial cells of the mammalian blood-brain barrier (Limmer et al., 2014).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00007091> "VFB:FBbt_00007091")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007091> "barrier glial cell layer")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00007091> "sub-perineurial glial sheath")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00007091> "fly_anatomy.ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0223187") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00007091> "blood-brain barrier")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00007091> "FBbt:00007091")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00007091> "That the subperineurial glial cells do not derive from the mesoderm is suggested by Edwards et al. (1994), in which they show the presence of these cells in delta (FBgn0000463) mutant embryos. 'Blood-brain barrier' may refer to this (e.g. Morante et al., 2013) or the perineurium (e.g. Limmer et al., 2014), which includes this and the perineurial glial sheath.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00007091> "subperineurial glial sheath")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007091> <http://purl.obolibrary.org/obo/FBbt_00007003>)
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007091> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/FBbt_00007090>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00007091> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002371> <http://purl.obolibrary.org/obo/FBbt_00007089>))

