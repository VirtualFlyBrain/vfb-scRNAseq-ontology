AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0210390") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00110635> "bilaterally projecting LN")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00110635> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00110635> "FBbt:00110635")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00110635> "Tanaka et al (2012) distinguishes four different types (LN3-6) based mainly on their innervation patterns. LN3 neurons innervate all glomeruli, LN4 innervate a few posterior glomeruli, LN5 innervate only one glomeruli and LN6 neurons innervate almost all the glomeruli and their cell bodies are located in the cell body rind of the gnathal ganglion.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00110635> "bilateral local interneuron of the adult antennal lobe")
