# Class: <http://purl.obolibrary.org/obo/FBbt_00004013> (gnathal ganglion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224194") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0237252") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00004013> "Region of the central nervous system consisting of the neuromeres of the three gnathal segments; mandibular, maxillary and labial (Ito et al., 2014; Hartenstein et al., 2018). It is located beneath the esophagus (Ito et al., 2014; Hartenstein et al., 2018). In the early larva, the three segmental neuromeres can be clearly identified, but they become fused during development and their segmental organization is obscured in the adult (Hartenstein et al., 2018).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00004013> "VFB:FBbt_00004013")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0224194") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00004013> "GNG")
