# Class: <http://purl.obolibrary.org/obo/FBbt_00100525> (adult optic chiasma glial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0096428") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0210316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0221770") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0239137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0243725") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00100525> "Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). It develops from neuroblast DL1 (CP2) (Viktorin et al., 2013; Ren et al., 2018; Plazaola-Sasieta et al., 2019). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997).")
AnnotationAssertion(<http://purl.org/dc/terms/contributor> <http://purl.obolibrary.org/obo/FBbt_00100525> <https://www.researchgate.net/scientific-contributions/Simon-Reeve-2162827703>)
AnnotationAssertion(<http://purl.org/dc/terms/date> <http://purl.obolibrary.org/obo/FBbt_00100525> "2011-05-23T01:49:16Z"^^xsd:dateTime)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00100525> "VFB:FBbt_00100525")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0234767") Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100525> "adult XG")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00100525> "adult optic chiasm glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00100525> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/FBbt_00100525> "giant glial cell")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00100525> "FBbt:00100525")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00100525> "Kremer et al. (2017) and Ren et al. (2018) expression analysis suggests that these are types of ensheathing glia, with inner tract glia being synaptic neuropil ensheathing and outer tract glia being tract neuropil ensheathing.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00100525> "adult optic chiasma glial cell")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00100525> <http://purl.obolibrary.org/obo/FBbt_00025991>)
