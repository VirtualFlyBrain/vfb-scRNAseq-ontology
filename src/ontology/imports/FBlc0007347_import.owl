# Class: <http://purl.obolibrary.org/obo/FBbt_00003127> (adult foregut)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0007735") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003127> "Anterior-most region of the adult alimentary canal. It consists (from anterior to posterior) of the posterior the pharynx (cibarium), esophagus, the crop, the stomodeal valve and part of the proventriculus.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00003127> "fly_anatomy.ontology")
