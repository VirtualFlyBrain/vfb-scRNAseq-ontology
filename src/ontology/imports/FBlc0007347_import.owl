AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000232> <http://purl.obolibrary.org/obo/RO_0002337> "Do not use this relation directly. It is a grouping relation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002337> "related via localization to"@en)
