# Class: <http://purl.obolibrary.org/obo/FBdv_00005319> (embryonic stage 7)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0089570") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBdv_00005319> "Stage 7 begins when the pole cells have adopted a dorsal (horizontal) position at the posterior. Invagination of the anterior and posterior midgut and hindgut follows. The 'discoid plate' that carries the pole cells forms a pocket. Transverse furrows (dorsal folds) form on the dorsal surface. This stage ends when the anterior wall of the amnioproctodeal invagination starts moving anteriorly and the pole cells are no longer visible externally. Duration at 25 degrees C: approximately 10 minutes (180-190 minutes after egg laying).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBdv_00005319> "FlyBase_development_CV")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBdv_00005319> "FBdv:00005319")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBdv_00005319> "Temporal ordering number - 240.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBdv_00005319> "embryonic stage 7")
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005319> <http://purl.obolibrary.org/obo/FBdv_00005259>)
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005319> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/FBdv_00018001> <http://purl.obolibrary.org/obo/FBdv_00005317>))
SubClassOf(<http://purl.obolibrary.org/obo/FBdv_00005319> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002087> <http://purl.obolibrary.org/obo/FBdv_00005318>))

