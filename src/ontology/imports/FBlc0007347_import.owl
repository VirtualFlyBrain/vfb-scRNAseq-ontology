AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00047861> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00047861> "FBbt:00047861")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00047861> "embryonic/larval lateral glial cell")
