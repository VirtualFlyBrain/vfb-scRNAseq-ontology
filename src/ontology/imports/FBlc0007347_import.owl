# Class: <http://purl.obolibrary.org/obo/FBbt_00003784> (medulla intrinsic neuron Mi9)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000028> <http://purl.obolibrary.org/obo/FBbt_00003784> "Mi9")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0049410") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0204652") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0222324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0235606") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0252485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0262545") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00003784> "Medulla intrinsic narrow field neuron with a bushy mix of bleb-type and fine terminal arborization in layers M2, M3 and M4 and in the lower medulla layers M9-M10 (Fischbach and Dittrich, 1989; Kind et al., 2021). It establishes pre- and post-synaptic connections in both the inner and outer medulla layers (Fischbach and Dittrich, 1989; Morante and Desplan, 2008). It receives input from lamina monopolar neuron L3 (Takemura et al., 2013). It is glutamatergic (Takemura et al., 2017). There is usually one of these cells per optic column (Nern et al., 2025).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00003784> "FlyBrain_NDB:10108")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/FBbt_00003784> "VFB:FBbt_00003784")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0247762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/fbbt#VFB_SYMBOL>) Annotation(rdf:type owl:Axiom) <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00003784> "Mi9")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/FBbt_00003784> "medullary intrinsic neuron Mi9")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00003784> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00003784> "FBbt:00003784")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00003784> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/FBbt_00003784> "Pre-synaptic terminals were assessed by labelling with a UAS-Synaptotagmin reporter (P{UAS-HA-syt} - FBtp0015803). The identification of dendrites and axons was done using a UAS-Dscam (P{UAS-Dscam.exon17.1.GFP} - FBtp0021447) or a UAS-tau (P{UAS-tau-lacZ.O} - FBtp0010033) reporter, respectively (Morante and Desplan, 2008). Connectivity in the medulla was extrapolated from serial EM from 7 columns (Takemura et al., 2013).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00003784> "medulla intrinsic neuron Mi9")
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/licence> <https://creativecommons.org/licenses/by/4.0/>) Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "doi:10.1007/s00359-019-01375-9") Annotation(rdf:type owl:Axiom) <http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/FBbt_00003784> "https://cdn.ncbi.nlm.nih.gov/pmc/blobs/bae0/7069908/ef7abe34662d/359_2019_1375_Fig2_HTML.jpg")
