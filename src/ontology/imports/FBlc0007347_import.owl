# Class: <http://purl.obolibrary.org/obo/FBbt_00005643> (embryonic Malpighian tubule tip cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FlyBase:FBrf0223292") Annotation(rdf:type owl:Axiom) <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FBbt_00005643> "Tip cell of the embryonic Malpighian tubule. It persists throughout tubule elongation during stages 13-16 and contacts a specific target by the end of the process (Weavers and Skaer, 2013). It adopts a specialized morphology with the cell body projecting from the tubule tip on the end of a microtubule-enriched stalk (Weavers and Skaer, 2013). It can extend filopodia and lamellipodia to explore its environment and remains free of basement membrane (Weavers and Skaer, 2013).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/FBbt_00005643> "fly_anatomy.ontology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/FBbt_00005643> "FBbt:00005643")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/FBbt_00005643> <http://purl.obolibrary.org/obo/fbbt#cur>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FBbt_00005643> "embryonic Malpighian tubule tip cell")
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00005643> <http://purl.obolibrary.org/obo/FBbt_00005642>)
