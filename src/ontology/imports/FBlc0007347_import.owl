SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003721> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013002> <http://purl.obolibrary.org/obo/FBbt_00003708>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003721> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013003> <http://purl.obolibrary.org/obo/FBbt_00003752>))
SubClassOf(<http://purl.obolibrary.org/obo/FBbt_00003721> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0013008> <http://purl.obolibrary.org/obo/FBbt_00006007>))
